extends SceneTree

## Writes scripts/games/arrow_pop/arrow_pop_levels.gd: all Arrow Pop levels, made from their
## seeds by ArrowPopEngine.generate(). Run again after changing the generator, then bump the pack.
## godot --headless --path . --script res://tools/gen_arrow_pop_levels.gd

const E = preload("res://scripts/games/arrow_pop/arrow_pop_engine.gd")

func _init() -> void:
	var e = E.new()
	var out := "extends RefCounted\n\n## Generated by tools/gen_arrow_pop_levels.gd -- don't edit by hand.\n## One level per line, see ArrowPopEngine.decode().\n\nconst LEVELS := [\n"
	for n in range(1, E.LEVEL_COUNT + 1):
		e.generate(n)
		out += "\t'%s',\n" % e.encode()  # single quotes: `hub.py i18n` only scans "..." for UI text
	out += "]\n"
	var f := FileAccess.open("res://scripts/games/arrow_pop/arrow_pop_levels.gd", FileAccess.WRITE)
	f.store_string(out)
	f.close()
	print("wrote %d levels" % E.LEVEL_COUNT)
	quit(0)
