extends SceneTree

## Writes scripts/games/color_sort/color_sort_par.gd: a par (good move count) for
## campaign levels 1..LEVELS. Optimal search first, then weighted search for the
## big boards; the scramble length is the fallback and the upper limit.
## godot --headless --path . --script res://tools/gen_color_sort_par.gd

const E = preload("res://scripts/games/color_sort/color_sort_engine.gd")
const S = preload("res://scripts/games/color_sort/color_sort_solver.gd")
const OUT := "res://scripts/games/color_sort/color_sort_par.gd"
const LEVELS := 300

func _init() -> void:
	var e = E.new()
	var pars: PackedStringArray = []
	var atts: PackedStringArray = []
	var exact := 0
	for n in range(1, LEVELS + 1):
		e.load_level(n)
		var best: int = e.gen_moves
		var r: Dictionary = S.solve(e.tubes, e.cap, 12000, 1.0, e._center_info(), e._solver_rules())
		if r.ok:
			exact += 1
		else:
			r = S.solve(e.tubes, e.cap, 40000, 3.0, e._center_info(), e._solver_rules())
		if r.ok:
			best = mini(best, r.moves.size())
		pars.append(str(best))
		atts.append(str(e.attempt_used))
		if n % 20 == 0:
			print("level ", n, " par ", best, " exact so far ", exact)
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("extends RefCounted\n\n## Generated by tools/gen_color_sort_par.gd. Do not hand-edit.\nconst PAR := [%s]\n## Which generator try each special level uses (-1 = the plain fallback).\nconst ATT := [%s]\n" % [", ".join(pars), ", ".join(atts)])
	f.close()
	print("wrote ", LEVELS, " pars, ", exact, " exact")
	quit()
