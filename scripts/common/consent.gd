extends RefCounted

## Legal consent + age gate (compliance pack, Task 2). APK-side only.
##
## Before an account is created the player picks a language, enters the MONTH
## and YEAR of birth (not "are you 13+?"), reads the Terms/EULA and the Privacy
## Policy as separate screens and ticks two unchecked boxes. Only the age
## BRACKET is kept ("<13", "13-15", "16-17", "18+"), never the birth date. Under
## the minimum age (13): no account, nothing sent anywhere, and a local flag so
## retyping a different year doesn't help (clearing the app's data does; it is
## self-declared and not verified, and the UI says so).
##
## Accepted versions live in user://consent.json. When signed in, they're
## recorded on the server (`consent_record`, supabase/migrations/
## 20261013020000_user_consents.sql) -- once per account and version. A newer
## legal VERSION (legal/placeholders.json, via scripts/common/legal_text.gd)
## asks again on the next sign-in / app start.
##
## The text itself is scripts/common/legal_text.gd (generated by
## tools/legal_build.py). Spanish controls; English is a courtesy copy.

const LegalText = preload("res://scripts/common/legal_text.gd")
const SaveUtil = preload("res://scripts/common/save_util.gd")

const PATH := "user://consent.json"
const ACCOUNT_SCENE := "res://scenes/account/account.tscn"
const HUB_SCENE := "res://scenes/hub/hub.tscn"
const CONSENT_SCENE := "res://scenes/account/consent.tscn"
const LEGAL_SCENE := "res://scenes/hub/legal.tscn"
## Server doc_type -> key in LegalText.DOCS.
const DOC_KEYS := {"terms_eula": "terms", "privacy": "privacy"}

## Where the consent screen goes when finished or cancelled.
static var return_scene: String = ACCOUNT_SCENE
## What the legal reader opens on: "terms" or "privacy".
static var reading_doc: String = "terms"
## Sign-up fields to put back after the consent detour.
static var draft: Dictionary = {}
## The hub asks a signed-in player to accept at most once per app session.
static var prompted: bool = false
## Where the Help screen's Back goes (set by whoever opens it).
static var help_back_scene: String = "res://scenes/hub/options.tscn"
const HELP_SCENE := "res://scenes/hub/help.tscn"

static func _state() -> Dictionary:
	if FileAccess.file_exists(PATH):
		var data = JSON.parse_string(FileAccess.get_file_as_string(PATH))
		if typeof(data) == TYPE_DICTIONARY:
			return data
	return {}

static func _save(state: Dictionary) -> void:
	SaveUtil.write(PATH, state)

static func min_age() -> int:
	return LegalText.MIN_AGE

static func version() -> String:
	return LegalText.VERSION

## "<13", "13-15", "16-17" or "18+". Conservative: someone born in the current
## month counts as not having had their birthday yet.
static func bracket_for(month: int, year: int, now: Dictionary = {}) -> String:
	var today: Dictionary = now if not now.is_empty() else Time.get_date_dict_from_system()
	var age: int = int(today.year) - year - (1 if int(today.month) <= month else 0)
	if age < min_age():
		return "<%d" % min_age()
	if age < 16:
		return "%d-15" % min_age()
	if age < 18:
		return "16-17"
	return "18+"

## Saves the bracket (never the date). Returns it; "<13" also sets the lock.
static func record_age(month: int, year: int) -> String:
	var b := bracket_for(month, year)
	var state := _state()
	if b.begins_with("<"):
		state["blocked"] = true
		state.erase("bracket")
	else:
		state["bracket"] = b
	_save(state)
	return b

static func is_blocked() -> bool:
	return bool(_state().get("blocked", false))

static func bracket() -> String:
	return str(_state().get("bracket", ""))

## The age range of the player's account for the ratings filter ("" = unknown).
static func max_game_age() -> int:
	match bracket():
		"13-15": return 12
		"16-17": return 16
		"18+": return 18
	return 12  # unknown: treated as the youngest allowed account

static func has_accepted() -> bool:
	var acc = _state().get("accepted", {})
	if typeof(acc) != TYPE_DICTIONARY:
		return false
	for t in DOC_KEYS:
		if str(acc.get(t, "")) != version():
			return false
	return true

## A signed-in player who hasn't accepted the current version (new account, an
## existing one from before this screen, or a version bump).
static func needs_prompt() -> bool:
	return _auth_logged_in() and not is_blocked() and not has_accepted()

## Records acceptance of the current version of both documents.
static func accept(locale: String) -> void:
	var state := _state()
	var acc := {}
	for t in DOC_KEYS:
		acc[t] = version()
	state["accepted"] = acc
	state["locale"] = locale
	state["accepted_at"] = int(Time.get_unix_time_from_system())
	_save(state)
	sync()

## Sends my acceptance to the server once per account and version. Quiet when
## offline / signed out / before the SQL is run (tries again next time).
static func sync() -> void:
	if not _auth_logged_in() or not has_accepted():
		return
	var state := _state()
	var uid := _auth_user_id()
	var synced = state.get("synced", {})
	if typeof(synced) == TYPE_DICTIONARY and str(synced.get(uid, "")) == version():
		return
	var auth = _auth()
	if auth == null:
		return
	auth.db_call("consent_record", {"p_version": version(), "p_locale": str(state.get("locale", "es")),
			"p_bracket": str(state.get("bracket", ""))}, _on_recorded.bind(uid))

static func _on_recorded(ok: bool, _result: Variant, uid: String) -> void:
	if not ok:
		return
	var state := _state()
	var synced = state.get("synced", {})
	if typeof(synced) != TYPE_DICTIONARY:
		synced = {}
	synced[uid] = version()
	state["synced"] = synced
	_save(state)

# ---------- the text ----------

## The rendered Terms or Privacy text ("terms" | "privacy") in `lang` ("es" | "en").
static func doc_markdown(doc: String, lang: String) -> String:
	var pair = LegalText.DOCS.get(doc, {})
	return str(pair.get(lang, pair.get("es", "")))

## Markdown (headings, bullets, **bold**, *italic*, > quotes, links) as BBCode for a
## RichTextLabel. No tables: the documents use bullets.
static func to_bbcode(md: String) -> String:
	var out := PackedStringArray()
	for raw in md.split("\n"):
		var line := raw.strip_edges(false, true)
		if line.strip_edges() == "":
			out.append("")
			continue
		var text := _inline(line)
		if line.begins_with("### "):
			out.append("[font_size=26][b]%s[/b][/font_size]" % _inline(line.substr(4)))
		elif line.begins_with("## "):
			out.append("[font_size=30][b][color=#7fb8ff]%s[/color][/b][/font_size]" % _inline(line.substr(3)))
		elif line.begins_with("# "):
			out.append("[font_size=36][b]%s[/b][/font_size]" % _inline(line.substr(2)))
		elif line.begins_with("- ") or line.begins_with("* "):
			out.append("  •  " + _inline(line.substr(2)))
		elif line.begins_with(">"):
			out.append("[i]%s[/i]" % _inline(line.substr(1).strip_edges()))
		else:
			out.append(text)
	return "\n".join(out)

static func _inline(s: String) -> String:
	# Literal brackets would be read as BBCode tags: escape them first.
	var t := s.replace("[", "[lb]")
	var link := RegEx.new()
	link.compile("\\[lb\\]([^\\]]+)\\]\\((https?://[^)\\s]+|mailto:[^)\\s]+)\\)")
	t = link.sub(t, "[url=$2]$1[/url]", true)
	var bold := RegEx.new()
	bold.compile("\\*\\*(.+?)\\*\\*")
	t = bold.sub(t, "[b]$1[/b]", true)
	var ital := RegEx.new()
	ital.compile("(?<![\\*\\w])\\*(?!\\s)([^*]+?)(?<!\\s)\\*(?![\\*\\w])")
	t = ital.sub(t, "[i]$1[/i]", true)
	return t

# ---------- autoload access (this is a plain script, not a node) ----------

static func _auth() -> Object:
	var loop := Engine.get_main_loop()
	return (loop as SceneTree).root.get_node_or_null("Auth") if loop is SceneTree else null

static func _auth_logged_in() -> bool:
	var a := _auth()
	return a != null and bool(a.is_logged_in())

static func _auth_user_id() -> String:
	var a := _auth()
	return str(a.user_id) if a != null else ""

## A read-only RichTextLabel with the document (links open in the browser).
static func make_reader(md: String, pal: Dictionary) -> RichTextLabel:
	var r := RichTextLabel.new()
	r.bbcode_enabled = true
	r.fit_content = true
	r.scroll_active = false
	r.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	r.selection_enabled = false
	r.mouse_filter = Control.MOUSE_FILTER_PASS
	r.add_theme_font_size_override("normal_font_size", 22)
	r.add_theme_font_size_override("bold_font_size", 22)
	r.add_theme_font_size_override("italics_font_size", 22)
	r.add_theme_color_override("default_color", pal.text)
	r.text = to_bbcode(md)
	r.meta_clicked.connect(_open_link)
	return r

static func _open_link(meta: Variant) -> void:
	OS.shell_open(str(meta))
