extends RefCounted

## Pure game logic for Creation -- no Nodes, no UI, so it is tested headlessly
## (tools/test_creation.gd). Everything the player owns lives here: what they
## found, which pairs failed, hints, settings and purchase state, plus the
## save format. The recipe data is generated by tools/creation/build.py
## (never edit creation_data.json by hand).
##
## Gating (creation_gate.gd): with the paywall on and no Full Game, results in
## paid tiers are NOT found; they are remembered as locked silhouettes and turn
## into real discoveries when the player unlocks (`refresh_unlock`).

const Gate = preload("res://scripts/games/creation/creation_gate.gd")

const SAVE_VERSION := 1
const FREE_HINTS_PER_DAY := 3
const SORT_RECENT := "recent"
const SORT_AZ := "az"
const SORT_TIER := "tier"
const DEFAULT_SETTINGS := {"lang": "auto", "theme": "auto"}

# ---- data (immutable after load_data) ----
var items: Dictionary = {}       # id -> {id, name{en,es}, emoji, starter, depth, tier, finale}
var item_order: Array = []       # ids, in data order
var tiers: Array = []            # [{id, name{en,es}, free}]
var starters: Array = []
var recipes: Dictionary = {}     # "a+b" (sorted) -> Array of result ids
var uses: Dictionary = {}        # id -> Array of recipe keys that use it

# ---- player state (saved) ----
var found: Array = []            # ids, in discovery order (last = newest)
var failed: Dictionary = {}      # "a+b" -> true: pairs that gave nothing
var seen_locked: Dictionary = {} # id -> true: paid-tier results seen but not collected
var workspace: Array = []        # [{id, x, y}] chips on the table (x, y = 0..1 fractions)
var hints_left: int = FREE_HINTS_PER_DAY
var hint_day: String = ""
var hints_used: int = 0
var hinted: Dictionary = {}      # recipe key -> how many of its ingredients were revealed
var hint_view: Array = []        # ingredient ids currently highlighted on the shelf
var hint_key: String = ""        # the recipe the highlight is about
var settings: Dictionary = DEFAULT_SETTINGS.duplicate()
var purchase: Dictionary = {"full": false}

# ---- runtime (not saved) ----
var paywall_on: bool = false     # Gate.live(); tests set it directly
var owns_full: bool = false      # the hub store says the player owns the Full Game
var _found_set: Dictionary = {}

# ------------------------------------------------------------------ data

static func key(a: String, b: String) -> String:
	return a + "+" + b if a <= b else b + "+" + a

static func parse_data(text: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(text)
	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}

## The validator (SPEC section 2): returns a list of problems, empty = good.
## No undefined ids, no duplicate pairs, every item reachable from the
## starters, every non-starter has a source, every item has a tier, names in
## both languages, and the free tiers can be completed on their own.
static func validate(data: Dictionary) -> Array:
	var errs: Array = []
	for k in ["starters", "items", "recipes", "tiers"]:
		if not data.has(k) or typeof(data[k]) != TYPE_ARRAY:
			errs.append("missing list '%s'" % k)
	if not errs.is_empty():
		return errs
	var ids: Dictionary = {}
	var tier_free: Dictionary = {}
	for t in data.tiers:
		tier_free[int(t.id)] = bool(t.get("free", false))
	for it in data.items:
		var id: String = str(it.get("id", ""))
		if id == "":
			errs.append("item without id")
			continue
		if ids.has(id):
			errs.append("duplicate item '%s'" % id)
		ids[id] = it
		var nm: Dictionary = it.get("name", {})
		if str(nm.get("en", "")) == "" or str(nm.get("es", "")) == "":
			errs.append("item '%s' lacks an EN or ES name" % id)
		if str(it.get("emoji", "")) == "":
			errs.append("item '%s' lacks an emoji" % id)
		if not tier_free.has(int(it.get("tier", 0))):
			errs.append("item '%s' has unknown tier %s" % [id, str(it.get("tier"))])
	for s in data.starters:
		if not ids.has(str(s)):
			errs.append("starter '%s' is not an item" % str(s))
	var rec: Dictionary = {}
	var produced: Dictionary = {}
	for r in data.recipes:
		var a: String = str(r.get("a", ""))
		var b: String = str(r.get("b", ""))
		var res: Array = r.get("results", [])
		if not ids.has(a) or not ids.has(b):
			errs.append("recipe %s+%s uses an undefined id" % [a, b])
		if res.is_empty():
			errs.append("recipe %s+%s has no result" % [a, b])
		for x in res:
			if not ids.has(str(x)):
				errs.append("recipe %s+%s gives undefined '%s'" % [a, b, str(x)])
			produced[str(x)] = true
		var k: String = key(a, b)
		if rec.has(k):
			errs.append("duplicate recipe %s" % k)
		rec[k] = res
	# Reachability from the starters, and again using free tiers only.
	var all_known: Dictionary = _closure(data.starters, rec, ids, func(_t: int) -> bool: return true)
	var free_known: Dictionary = _closure(data.starters, rec, ids, func(t: int) -> bool: return tier_free.get(t, false))
	for id in ids:
		if not all_known.has(id):
			errs.append("'%s' is unreachable from the starters" % id)
		elif not data.starters.has(id) and not produced.has(id):
			errs.append("'%s' has no source" % id)
		if tier_free.get(int(ids[id].tier), false) and not free_known.has(id):
			errs.append("free-tier item '%s' needs a paid-tier ingredient" % id)
	return errs

static func _closure(starters: Array, rec: Dictionary, ids: Dictionary, tier_ok: Callable) -> Dictionary:
	var known: Dictionary = {}
	for s in starters:
		known[str(s)] = true
	var changed: bool = true
	while changed:
		changed = false
		for k in rec:
			var p: PackedStringArray = str(k).split("+")
			if known.has(p[0]) and known.has(p[1]):
				for r in rec[k]:
					var rid: String = str(r)
					if ids.has(rid) and not known.has(rid) and tier_ok.call(int(ids[rid].tier)):
						known[rid] = true
						changed = true
	return known

## Loads the generated data. Returns the validator's problems (empty = ok).
func load_data(data: Dictionary) -> Array:
	var errs: Array = validate(data)
	if not errs.is_empty():
		return errs
	items.clear()
	item_order.clear()
	recipes.clear()
	uses.clear()
	for it in data.items:
		var d: Dictionary = it.duplicate(true)
		d.tier = int(d.tier)
		d.depth = int(d.get("depth", 0))
		items[d.id] = d
		item_order.append(d.id)
		uses[d.id] = []
	tiers = data.tiers.duplicate(true)
	for t in tiers:
		t.id = int(t.id)
	starters = []
	for s in data.starters:
		starters.append(str(s))
	for r in data.recipes:
		var k: String = key(str(r.a), str(r.b))
		recipes[k] = []
		for x in r.results:
			recipes[k].append(str(x))
		for side in [str(r.a), str(r.b)]:
			if not uses[side].has(k):
				uses[side].append(k)
	reset_progress()
	return []

## A brand-new game: just the starters. Keeps settings and purchase state.
func reset_progress() -> void:
	found = []
	_found_set = {}
	failed = {}
	seen_locked = {}
	workspace = []
	hinted = {}
	hint_view = []
	hint_key = ""
	hints_used = 0
	hints_left = FREE_HINTS_PER_DAY
	hint_day = ""
	for s in starters:
		_add_found(s)

# ------------------------------------------------------------------ queries

func is_found(id: String) -> bool:
	return _found_set.has(id)

func found_count() -> int:
	return found.size()

func total() -> int:
	return items.size()

func tier_open(tier: int) -> bool:
	return Gate.tier_unlocked(tier, owns_full_game(), paywall_on)

## The Full Game was bought (hub store or saved purchase).
func owns_full_game() -> bool:
	return owns_full or bool(purchase.get("full", false))

## Every tier is open: nothing is for sale yet, or the Full Game is owned.
func has_full() -> bool:
	return not paywall_on or owns_full_game()

## [found, total] for one tier ("Tier 2: 31/51").
func tier_progress(tier: int) -> Array:
	var n: int = 0
	var f: int = 0
	for id in item_order:
		if int(items[id].tier) == tier:
			n += 1
			if _found_set.has(id):
				f += 1
	return [f, n]

func tier_name(tier: int, lang: String) -> String:
	for t in tiers:
		if int(t.id) == tier:
			return str(t.name.get(lang, t.name.en))
	return ""

func name_of(id: String, lang: String) -> String:
	var it: Dictionary = items.get(id, {})
	if it.is_empty():
		return id
	return str(it.name.get(lang, it.name.en))

func emoji_of(id: String) -> String:
	return str(items.get(id, {}).get("emoji", "?"))

func tier_of(id: String) -> int:
	return int(items.get(id, {}).get("tier", 0))

## "en" or "es": the manual choice, else the device locale.
func resolve_lang(locale: String) -> String:
	var l: String = str(settings.get("lang", "auto"))
	if l == "en" or l == "es":
		return l
	return "es" if locale.to_lower().begins_with("es") else "en"

## What a pair makes (order never matters). Empty = nothing.
func combine(a: String, b: String) -> Array:
	return recipes.get(key(a, b), [])

## Number of recipes using `id` that still have a result you haven't found
## (count only -- no spoilers).
func unfound_uses(id: String) -> int:
	var n: int = 0
	for k in uses.get(id, []):
		for r in recipes[k]:
			if not _found_set.has(r):
				n += 1
				break
	return n

func is_failed(a: String, b: String) -> bool:
	return failed.has(key(a, b))

# ------------------------------------------------------------------ playing

func _add_found(id: String) -> void:
	if _found_set.has(id):
		return
	_found_set[id] = true
	found.append(id)
	seen_locked.erase(id)

## The one move: put `a` and `b` together. Returns
## {status, results, new, locked} where status is
##   "new"           at least one result was discovered now
##   "known"         everything it makes you already had
##   "locked"        only paid-tier results (shown as silhouettes)
##   "miss"          nothing happens (remembered)
##   "failed_before" nothing happens, and you already tried this pair
##   "invalid"       one of the items isn't yours
func try_combine(a: String, b: String) -> Dictionary:
	var out: Dictionary = {"status": "invalid", "results": [], "new": [], "locked": []}
	if not _found_set.has(a) or not _found_set.has(b):
		return out
	var k: String = key(a, b)
	var res: Array = combine(a, b)
	if res.is_empty():
		out.status = "failed_before" if failed.has(k) else "miss"
		failed[k] = true
		return out
	out.results = res.duplicate()
	for r in res:
		if not tier_open(tier_of(r)):
			out.locked.append(r)
			seen_locked[r] = true
		elif not _found_set.has(r):
			_add_found(r)
			out.new.append(r)
	if not out.new.is_empty():
		out.status = "new"
	elif not out.locked.is_empty():
		out.status = "locked"
	else:
		out.status = "known"
	_clear_hint_if_done()
	return out

## After buying the Full Game: collect every silhouette. Returns the new ids.
func refresh_unlock() -> Array:
	var got: Array = []
	for id in seen_locked.keys():
		if tier_open(tier_of(id)):
			_add_found(id)
			got.append(id)
	return got

func set_full_purchased(on: bool) -> void:
	purchase["full"] = on

# ------------------------------------------------------------------ shelf

static func fold(s: String) -> String:
	var t: String = s.to_lower()
	for pair in [["á", "a"], ["é", "e"], ["í", "i"], ["ó", "o"], ["ú", "u"], ["ü", "u"], ["ñ", "n"]]:
		t = t.replace(pair[0], pair[1])
	return t

## Ids for the shelf. `tier_filter` 0 = all. Search looks in both languages.
## Locked silhouettes (paid-tier results seen) come last and are not searchable.
func list_items(query: String, sort: String, tier_filter: int, lang: String) -> Array:
	var q: String = fold(query.strip_edges())
	var out: Array = []
	for id in found:
		if tier_filter != 0 and tier_of(id) != tier_filter:
			continue
		if q != "":
			var nm: Dictionary = items[id].name
			if not fold(str(nm.en)).contains(q) and not fold(str(nm.es)).contains(q):
				continue
		out.append(id)
	match sort:
		SORT_AZ:
			out.sort_custom(func(x: String, y: String) -> bool:
				var nx: String = fold(name_of(x, lang))
				var ny: String = fold(name_of(y, lang))
				return nx < ny if nx != ny else x < y)
		SORT_TIER:
			out.sort_custom(func(x: String, y: String) -> bool:
				var tx: int = tier_of(x)
				var ty: int = tier_of(y)
				if tx != ty:
					return tx < ty
				var nx: String = fold(name_of(x, lang))
				var ny: String = fold(name_of(y, lang))
				return nx < ny if nx != ny else x < y)
		_:
			out.reverse()  # newest first
	if q == "":
		var sil: Array = seen_locked.keys()
		sil.sort()
		for id in sil:
			if tier_filter == 0 or tier_of(id) == tier_filter:
				out.append(id)
	return out

# ------------------------------------------------------------------ hints

func _roll_day(today: String) -> void:
	if hint_day != today:
		hint_day = today
		hints_left = FREE_HINTS_PER_DAY

## How many hints the player can use now (a big number when unlimited).
func hints_available(today: String) -> int:
	if Gate.unlimited_hints(owns_full_game()):
		return 999
	_roll_day(today)
	return hints_left

## Recipes you could make right now that would discover something new,
## easiest first (lowest depth, then key) -- the hint pool.
func hint_candidates() -> Array:
	var out: Array = []
	for k in recipes:
		var p: PackedStringArray = str(k).split("+")
		if not _found_set.has(p[0]) or not _found_set.has(p[1]):
			continue
		var d: int = 0
		var open_new: bool = false
		for r in recipes[k]:
			if not _found_set.has(r) and tier_open(tier_of(r)):
				open_new = true
				d = maxi(d, int(items[r].depth))
		if open_new:
			out.append([d, k])
	out.sort()
	var keys: Array = []
	for e in out:
		keys.append(e[1])
	return keys

## Reveals ONE ingredient of something you haven't found. Asking again about
## the same recipe reveals its other ingredient; then it moves on.
## Returns {ok, ingredients, second, reason}; costs a free hint only if ok.
func use_hint(today: String) -> Dictionary:
	if hints_available(today) <= 0:
		return {"ok": false, "reason": "none_left", "ingredients": []}
	var cands: Array = hint_candidates()
	if cands.is_empty():
		return {"ok": false, "reason": "nothing_to_hint", "ingredients": []}
	var pick: String = ""
	for k in cands:
		var p: PackedStringArray = str(k).split("+")
		var need: int = 1 if p[0] == p[1] else 2
		if int(hinted.get(k, 0)) < need:
			pick = k
			break
	if pick == "":
		hinted.clear()
		pick = cands[0]
	var parts: PackedStringArray = pick.split("+")
	var first: String = parts[0]
	var other: String = parts[1]
	# Show the less obvious one first (the deeper item; ties: alphabetical).
	if int(items[other].depth) > int(items[first].depth):
		first = parts[1]
		other = parts[0]
	var shown: int = int(hinted.get(pick, 0))
	var second: bool = shown >= 1
	hinted[pick] = shown + 1
	hint_key = pick
	hint_view = [first]
	if second and other != first:
		hint_view.append(other)
	if not Gate.unlimited_hints(owns_full_game()):
		hints_left = maxi(0, hints_left - 1)
	hints_used += 1
	return {"ok": true, "ingredients": hint_view.duplicate(), "second": second, "reason": ""}

func _clear_hint_if_done() -> void:
	if hint_key == "":
		return
	for r in recipes.get(hint_key, []):
		if not _found_set.has(r) and tier_open(tier_of(r)):
			return
	hint_key = ""
	hint_view = []

# ------------------------------------------------------------------ save

func to_save() -> Dictionary:
	return {
		"v": SAVE_VERSION,
		"found": found.duplicate(),
		"failed": failed.keys(),
		"locked": seen_locked.keys(),
		"workspace": workspace.duplicate(true),
		"hints": {"left": hints_left, "day": hint_day, "used": hints_used,
			"hinted": hinted.duplicate(), "view": hint_view.duplicate(), "key": hint_key},
		"settings": settings.duplicate(),
		"purchase": purchase.duplicate(),
	}

## Older saves are upgraded one version at a time (none yet: this is v1).
static func migrate(d: Dictionary) -> Dictionary:
	var v: int = int(d.get("v", 0))
	if v < 1:
		d = d.duplicate()
		d["v"] = 1
	return d

## Restores a save made by to_save(). Unknown ids are dropped, the starters
## are always present, a save from a newer version loads what it understands.
## Returns false only for something that isn't a save at all.
func from_save(raw: Dictionary) -> bool:
	if raw.is_empty() or not raw.has("found"):
		return false
	var d: Dictionary = migrate(raw)
	reset_progress()
	for id in d.get("found", []):
		if items.has(str(id)):
			_add_found(str(id))
	for k in d.get("failed", []):
		var p: PackedStringArray = str(k).split("+")
		if p.size() == 2 and items.has(p[0]) and items.has(p[1]):
			failed[key(p[0], p[1])] = true
	for id in d.get("locked", []):
		if items.has(str(id)) and not _found_set.has(str(id)):
			seen_locked[str(id)] = true
	workspace = []
	for w in d.get("workspace", []):
		if typeof(w) == TYPE_DICTIONARY and items.has(str(w.get("id", ""))):
			workspace.append({"id": str(w.id), "x": clampf(float(w.get("x", 0.5)), 0.0, 1.0), "y": clampf(float(w.get("y", 0.5)), 0.0, 1.0)})
	var h: Dictionary = d.get("hints", {})
	hints_left = clampi(int(h.get("left", FREE_HINTS_PER_DAY)), 0, FREE_HINTS_PER_DAY)
	hint_day = str(h.get("day", ""))
	hints_used = maxi(0, int(h.get("used", 0)))
	hinted = {}
	for k in h.get("hinted", {}):
		if recipes.has(str(k)):
			hinted[str(k)] = clampi(int(h.hinted[k]), 0, 2)
	hint_view = []
	for id in h.get("view", []):
		if items.has(str(id)):
			hint_view.append(str(id))
	hint_key = str(h.get("key", "")) if recipes.has(str(h.get("key", ""))) else ""
	var s: Dictionary = DEFAULT_SETTINGS.duplicate()
	var rs: Dictionary = d.get("settings", {})
	for sk in s:
		if rs.has(sk) and typeof(rs[sk]) == typeof(s[sk]):
			s[sk] = rs[sk]
	if not (s.lang in ["auto", "en", "es"]):
		s.lang = "auto"
	if not (s.theme in ["auto", "dark", "light"]):
		s.theme = "auto"
	settings = s
	purchase = {"full": bool(d.get("purchase", {}).get("full", false))}
	_clear_hint_if_done()
	return true
