func _save_game() -> void:
	if not loaded:
		return
	engine.workspace = []
	for c in table.chips():
		engine.workspace.append({"id": c.item_id, "x": c.frac.x, "y": c.frac.y})
	SaveUtil.write(SAVE_PATH, engine.to_save())

func _exit_tree() -> void:
