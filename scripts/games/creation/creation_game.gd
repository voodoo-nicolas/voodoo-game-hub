extends Control

## Creation -- start with Earth, Fire, Wind and Water and combine items to
## discover everything (263 items). The whole UI is built in code; the logic
## is in creation_engine.gd (tested headless), data in creation_data.json
## (generated by tools/creation/build.py).
##
## One screen: a table on top (items float freely: drag one onto another, or
## tap two), the shelf of everything you found underneath. Drag a shelf item
## to the table (touch: hold, then drag; a tap drops it on the table), drag a
## chip to the trash, double-tap to duplicate. 💡 hints, 📖 collection, ⚙ settings.

const CreationEngine = preload("res://scripts/games/creation/creation_engine.gd")
const Gate = preload("res://scripts/games/creation/creation_gate.gd")
const HomeKit = preload("res://scripts/games/creation/home_kit.gd")
