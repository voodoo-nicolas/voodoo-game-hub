func _icon_button(text: String, handler: Callable) -> Button:
	var b := Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(70, 62)
	b.add_theme_font_size_override("font_size", 28)
	b.pressed.connect(handler)
	return b

func _fit_layout() -> void:
	if layout == null:
		return
	layout.vertical = size.x < size.y * 1.05
	if table != null and table.get_parent() != null:
		table.get_parent().size_flags_stretch_ratio = 1.0 if layout.vertical else 1.3

func _fill_tier_options() -> void:
	var keep: int = tier_opt.selected if tier_opt.item_count > 0 else 0
	tier_opt.clear()
	tier_opt.add_item(tr("All tiers"), 0)
	for t in engine.tiers:
		tier_opt.add_item("%d · %s" % [int(t.id), engine.tier_name(int(t.id), lang)], int(t.id))
	tier_opt.select(clampi(keep, 0, tier_opt.item_count - 1))

func _build_home() -> void:
	home = HomeKit.new({
		"help": Help,
		"info": info,
		"accent": HomeKit.LIME,
		"subtitle": "Combine four elements into everything.",
		# The key art already shows the four elements: no drawn logo (the old one stays below).
