# ---------------------------------------------------------------- skins / theme

func _set_skin(name: String) -> void:
	skin = "voodoo" if name == "voodoo" else "classic"
	pal = _palette()
	if bg == null:
		return
	bg.color = pal.bg
	ui.theme = _make_theme()
	title_label.add_theme_color_override("font_color", pal.text)
	count_label.add_theme_color_override("font_color", pal.text)
	info_label.add_theme_color_override("font_color", pal.dim)
	count_bar.add_theme_stylebox_override("background", _flat(pal.panel, pal.border, 2, 6))
	count_bar.add_theme_stylebox_override("fill", _flat(pal.accent, pal.accent, 0, 6))
	toast_panel.add_theme_stylebox_override("panel", _flat(Color(pal.panel, 0.96), pal.accent, 2, 14, 10))
	toast_label.add_theme_color_override("font_color", pal.text)
	ghost.add_theme_color_override("font_color", pal.text)
	table.pal = pal
	table.clear_btn.add_theme_font_size_override("font_size", 22)
	table.queue_redraw()
	for c in table.chips():
		c.restyle(pal)
	for c in shelf_flow.get_children():
		if c is Chip:
			c.restyle(pal)
	if _modal != null:
		_close_modal()

func _current_skin() -> String:
	return skin

func _is_dark() -> bool:
	if skin == "voodoo":
		return true
	match str(engine.settings.theme):
		"dark":
			return true
		"light":
			return false
	var s = get_node_or_null("/root/Settings")
	return not (s != null and s.has_method("is_light") and s.is_light())

func _palette() -> Dictionary:
	if skin == "voodoo":
		return {"bg": HomeKit.BG, "table": Color("0a1122"), "panel": HomeKit.PANEL, "chip": Color("101a30"),
			"border": Color(HomeKit.CYAN, 0.75), "text": HomeKit.WHITE, "dim": HomeKit.DIM, "accent": HomeKit.MAGENTA,
			"good": HomeKit.LIME, "bad": HomeKit.PINK, "hint": HomeKit.GOLD, "button": Color("14305a")}
	if _is_dark():
		return {"bg": Color("141a25"), "table": Color("202a3c"), "panel": Color("1b2333"), "chip": Color("2d3a54"),
			"border": Color("56688f"), "text": Color("eef2fb"), "dim": Color("9fabc4"), "accent": Color("6aaeff"),
			"good": Color("5fe08a"), "bad": Color("ff6b7a"), "hint": Color("ffc43a"), "button": Color("2b4a80")}
	return {"bg": Color("e9e3d3"), "table": Color("fbf8ee"), "panel": Color("f2ecdc"), "chip": Color("ffffff"),
		"border": Color("a99f86"), "text": Color("1d2433"), "dim": Color("535c70"), "accent": Color("1e5bd8"),
		"good": Color("1c8a43"), "bad": Color("c4262e"), "hint": Color("b86e00"), "button": Color("dbe6fb")}

func _flat(fill: Color, border: Color, width: int = 2, radius: int = 12, margin: int = 0) -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.bg_color = fill
	sb.border_color = border
	sb.set_border_width_all(width)
	sb.set_corner_radius_all(radius)
	if margin > 0:
		sb.set_content_margin_all(margin)
	return sb

func _make_theme() -> Theme:
	var t := Theme.new()
	t.default_font_size = 22
	t.set_color("font_color", "Label", pal.text)
	for st in ["normal", "hover", "pressed", "focus", "disabled"]:
		var fill: Color = pal.button
		var border: Color = pal.border
		if st == "hover":
			fill = fill.lightened(0.1)
		elif st == "pressed":
			fill = fill.darkened(0.15)
			border = pal.accent
		elif st == "disabled":
			fill = Color(fill, 0.5)
		for cls in ["Button", "OptionButton", "MenuButton"]:
			t.set_stylebox(st, cls, _flat(fill, border, 2, 14, 8))
	for cls in ["Button", "OptionButton"]:
		t.set_color("font_color", cls, pal.text)
		t.set_color("font_hover_color", cls, pal.text)
		t.set_color("font_pressed_color", cls, pal.text)
		t.set_color("font_focus_color", cls, pal.text)
		t.set_color("font_hover_pressed_color", cls, pal.text)
		t.set_color("font_disabled_color", cls, Color(pal.dim, 0.7))
	t.set_stylebox("normal", "LineEdit", _flat(pal.panel, pal.border, 2, 14, 8))
	t.set_stylebox("focus", "LineEdit", _flat(pal.panel, pal.accent, 3, 14, 8))
	t.set_color("font_color", "LineEdit", pal.text)
	t.set_color("font_placeholder_color", "LineEdit", pal.dim)
	t.set_color("caret_color", "LineEdit", pal.accent)
	t.set_stylebox("panel", "PanelContainer", _flat(pal.panel, pal.border, 2, 18, 18))
	t.set_stylebox("panel", "PopupMenu", _flat(pal.panel, pal.border, 2, 10, 6))
	t.set_color("font_color", "PopupMenu", pal.text)
	t.set_color("font_hover_color", "PopupMenu", pal.text)
	t.set_stylebox("hover", "PopupMenu", _flat(Color(pal.accent, 0.35), pal.accent, 0, 8, 4))
	t.set_font_size("font_size", "PopupMenu", 22)
	return t

# ---------------------------------------------------------------- helpers

func _sfx(sound: String) -> void:
