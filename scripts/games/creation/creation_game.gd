# ---------------------------------------------------------------- toasts

func _toast(text: String, seconds: float = 2.4) -> void:
	toast_label.text = text
	toast_label.custom_minimum_size.x = clampf(table.size.x - 240.0, 120.0, 380.0)
	toast_panel.visible = true
	toast_panel.reset_size()
	# bottom strip, between the trash and Clear: it never covers the chips being made
	toast_panel.position = Vector2(80.0 + maxf(0.0, (table.size.x - 220.0 - toast_panel.size.x) / 2.0), table.size.y - toast_panel.size.y - 10.0)
	toast_timer.start(seconds)

func _hide_toast() -> void:
	toast_panel.visible = false

# ---------------------------------------------------------------- table logic

func _make_chip(id: String, size_v: Vector2) -> Chip:
	var c := Chip.new()
	c.setup(id, engine.emoji_of(id), engine.name_of(id, lang), pal, size_v)
	return c

func _restore_workspace() -> void:
	for w in engine.workspace:
		var c := _make_chip(str(w.id), TABLE_CHIP)
		c.frac = Vector2(float(w.x), float(w.y))
		table.add_child(c)
		table.place(c)

func _add_to_table(id: String, at = null) -> Chip:
	if table.chips().size() >= MAX_CHIPS:
		_toast(tr("The table is full. Remove or clear some items."))
		_sfx("invalid")
		return null
	var c := _make_chip(id, TABLE_CHIP)
	table.add_child(c)
	var pos: Vector2 = at if at != null else table.free_spot(c)
	pos = pos.clamp(Vector2.ZERO, (table.size - c.size).max(Vector2.ZERO))
	c.position = pos
	c.frac = table.fraction_of(pos, c)
	c.set_hinted(engine.hint_view.has(id))
	_pop(c)
	return c

func _pop(c: Control) -> void:
	c.scale = Vector2(0.4, 0.4)
	var tw := c.create_tween()
	tw.tween_property(c, "scale", Vector2.ONE, 0.22).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func _shake(c: Control) -> void:
	if not is_instance_valid(c):
		return
	var base: Vector2 = c.position
	var tw := c.create_tween()
	for dx in [-9.0, 9.0, -6.0, 6.0, 0.0]:
		tw.tween_property(c, "position", base + Vector2(dx, 0), 0.05)

func _remove_chip(c: Chip, animate: bool = true) -> void:
	if c.dying:
		return
	c.dying = true
	if table.selected == c:
		table.selected = null
	if table.last_tap_chip == c:
		table.last_tap_chip = null
	if animate:
		var tw := c.create_tween()
		tw.tween_property(c, "scale", Vector2.ZERO, 0.12)
		tw.tween_callback(c.queue_free)
	else:
		c.queue_free()

func _on_table_tapped(c) -> void:
	if c == null:
		table.select(null)
		return
	var sel = table.selected
	if sel != null and is_instance_valid(sel) and sel != c and not sel.dying:
		table.select(null)
		_combine(sel, c)
		return
	if sel == c:
		table.select(null)
	else:
		table.select(c)
		_show_info(c.item_id)
		_sfx("tick")

func _on_duplicated(c) -> void:
	table.select(null)
	if not is_instance_valid(c) or c.dying:
		return
	var n = _add_to_table(c.item_id, c.position + Vector2(26, 26))
	if n != null:
		_sfx("place")
		_on_arranged()

func _on_chip_removed(c) -> void:
	if table.selected == c:
		table.select(null)
	_sfx("back")
	_remove_chip(c)
	_on_arranged()

func _on_clear() -> void:
	if table == null:
		return
	table.select(null)
	for c in table.chips():
		_remove_chip(c)
	_sfx("back")
	_on_arranged()

func _on_arranged() -> void:
	_save_game()

func _on_combine_requested(a, b) -> void:
	table.select(null)
	_combine(a, b)

## The heart of the game: two chips meet.
func _combine(a: Chip, b: Chip) -> void:
	if a.dying or b.dying:
		return
	var r: Dictionary = engine.try_combine(a.item_id, b.item_id)
	var mid: Vector2 = (a.position + b.position) / 2.0
	match r.status:
		"miss", "failed_before":
			_shake(a)
			_shake(b)
			_sfx("invalid")
			_toast(tr("You already tried that.") if r.status == "failed_before" else tr("Nothing happens."), 1.6)
			# nudge the dragged chip off the other so it doesn't sit on top of it
			var away: Vector2 = (a.position - b.position)
			if away.length() < 1.0:
				away = Vector2(1, 0)
			var np: Vector2 = (a.position + away.normalized() * (a.size.x * 0.55)).clamp(Vector2.ZERO, (table.size - a.size).max(Vector2.ZERO))
			var tw := a.create_tween()
			tw.tween_interval(0.3)
			tw.tween_property(a, "position", np, 0.18)
			tw.tween_callback(_chip_settled.bind(a))
			if info:
				info.add("Pairs tried")
			_save_game()
		"invalid":
			pass
		_:
			_remove_chip(a)
			_remove_chip(b)
			var spawn: Array = []
			for id in r.results:
				if not r.locked.has(id):
					spawn.append(id)
			var n: int = spawn.size()
			for i in n:
				var off := Vector2((i - (n - 1) / 2.0) * (TABLE_CHIP.x * 0.62), 0)
				_add_to_table(spawn[i], mid + off)
			if r.status == "new":
				var names: Array = []
				for id in r.new:
					names.append(_label_of(id))
				_toast("✨ " + tr("New!") + "  " + "  ".join(names), 2.4)
				_burst(mid + TABLE_CHIP / 2.0)
				_new_popup(mid + Vector2(TABLE_CHIP.x / 2.0, 0))
				_pulse_counter()
				_sfx("powerup")
				_buzz(45)
				if info:
					info.high("Discoveries", engine.found_count())
				_refresh_all()
			elif r.status == "locked":
				_toast(tr("🔒 A discovery from the Full Game tiers. Unlock it to collect it."), 3.2)
				_sfx("toggle")
				_rebuild_shelf()
			else:
				_toast(tr("You already have %s") % _label_of(r.results[0]), 1.8)
				_sfx("pickup")
			if not r.locked.is_empty() and r.status == "new":
				_rebuild_shelf()
			_save_game()

func _chip_settled(c: Chip) -> void:
	if is_instance_valid(c) and not c.dying:
		c.frac = table.fraction_of(c.position, c)
		_save_game()

func _burst(at: Vector2) -> void:
	var p := CPUParticles2D.new()
	p.position = at
	p.amount = 18
	p.one_shot = true
	p.explosiveness = 1.0
	p.lifetime = 0.7
	p.direction = Vector2.UP
	p.spread = 180.0
	p.initial_velocity_min = 90.0
	p.initial_velocity_max = 220.0
	p.gravity = Vector2(0, 260)
	p.scale_amount_min = 3.0
	p.scale_amount_max = 7.0
	p.color = pal.accent
	p.emitting = true
	p.finished.connect(p.queue_free)
	table.add_child(p)

func _new_popup(at: Vector2) -> void:
	var l := Label.new()
	l.text = tr("New!")
	l.add_theme_font_size_override("font_size", 34)
	l.add_theme_color_override("font_color", pal.good)
	l.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.6))
	l.add_theme_constant_override("outline_size", 6)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	l.position = at - Vector2(40, 10)
	table.add_child(l)
	var tw := l.create_tween()
	tw.set_parallel(true)
	tw.tween_property(l, "position:y", l.position.y - 56, 0.9)
	tw.tween_property(l, "modulate:a", 0.0, 0.9).set_delay(0.3)
	tw.chain().tween_callback(l.queue_free)

func _pulse_counter() -> void:
	count_label.pivot_offset = Vector2(0, count_label.size.y / 2.0)
	var tw := count_label.create_tween()
	tw.tween_property(count_label, "scale", Vector2(1.18, 1.18), 0.1)
	tw.tween_property(count_label, "scale", Vector2.ONE, 0.18)

# ---------------------------------------------------------------- shelf

func _filter_sort() -> String:
	return str(_sort_keys[clampi(sort_opt.selected, 0, 2)])

func _filter_tier() -> int:
	return tier_opt.get_item_id(tier_opt.selected) if tier_opt.item_count > 0 else 0

func _on_filter_changed() -> void:
	_rebuild_shelf()

func _rebuild_shelf() -> void:
	if shelf_flow == null:
		return
	for c in shelf_flow.get_children():
		shelf_flow.remove_child(c)
		c.queue_free()
	var ids: Array = engine.list_items(search.text, _filter_sort(), _filter_tier(), lang)
	for id in ids:
		var c: Chip
		if engine.is_found(id):
			c = _make_chip(id, SHELF_CHIP)
			c.set_hinted(engine.hint_view.has(id))
		else:
			c = Chip.new()
			c.setup(id, "🔒", "???", pal, SHELF_CHIP)
			c.set_state("locked")
		shelf_flow.add_child(c)
	if ids.is_empty():
		var l := Label.new()
		l.text = tr("No matches.")
		l.add_theme_color_override("font_color", pal.dim)
		shelf_flow.add_child(l)

func shelf_item_at(p: Vector2):
	for c in shelf_flow.get_children():
		if c is Chip and c.get_global_rect().has_point(p):
			return c
	return null

func _show_info(id: String) -> void:
	var n: int = engine.unfound_uses(id)
	var tail: String
	if n == 0:
		tail = tr("every recipe with it is found")
	elif n == 1:
		tail = tr("used in 1 recipe you haven't found")
	else:
		tail = tr("used in %d recipes you haven't found") % n
	info_label.text = "%s · %s · %s" % [_label_of(id), engine.tier_name(engine.tier_of(id), lang), tail]

func shelf_tap(item: Chip) -> void:
	if item.state == "locked":
		_show_unlock()
		return
	_show_info(item.item_id)
	var sel = table.selected
	var c = _add_to_table(item.item_id, null if sel == null or not is_instance_valid(sel) else _spot_beside(sel))
	if c == null:
		return
	_sfx("place")
	if sel != null and is_instance_valid(sel) and not sel.dying:
		table.select(null)
		_combine(sel, c)
	else:
		_on_arranged()

func _spot_beside(c: Chip) -> Vector2:
	var right: Vector2 = c.position + Vector2(c.size.x * 0.8, 0)
	if right.x + TABLE_CHIP.x > table.size.x:
		right = c.position - Vector2(c.size.x * 0.8, 0)
	return right

func shelf_drag_begin(item: Chip, pos: Vector2) -> void:
	if item.state == "locked":
		return
	_show_info(item.item_id)
	ghost.text = engine.emoji_of(item.item_id)
	ghost.visible = true
	_buzz(20)
	shelf_drag_move(item, pos)

func shelf_drag_move(item: Chip, pos: Vector2) -> void:
	ghost.position = ui.get_global_transform().affine_inverse() * pos - ghost.size / 2.0
	var local: Vector2 = table.get_global_transform().affine_inverse() * pos
	var t = null
	if Rect2(Vector2.ZERO, table.size).has_point(local):
		t = table.target_for(Rect2(local - TABLE_CHIP / 2.0, TABLE_CHIP), null)
	table.set_target(t, item.item_id)

func shelf_drag_end(item: Chip, pos: Vector2) -> void:
	ghost.visible = false
	table.set_target(null)
	var local: Vector2 = table.get_global_transform().affine_inverse() * pos
	if item.state == "locked" or not Rect2(Vector2.ZERO, table.size).has_point(local):
		return
	var target = table.target_for(Rect2(local - TABLE_CHIP / 2.0, TABLE_CHIP), null)
	var c = _add_to_table(item.item_id, local - TABLE_CHIP / 2.0)
	if c == null:
		return
	_sfx("place")
	if target != null and is_instance_valid(target):
		_combine(c, target)
	else:
		_on_arranged()

func _scroll_to_hint() -> void:
	for c in shelf_flow.get_children():
		if c is Chip and c.hinted:
			shelf_scroll.scroll_vertical = maxi(0, int(c.position.y) - 8)
			return

# ---------------------------------------------------------------- counters / refresh

func _refresh_all() -> void:
	if info_label.text == "":
		info_label.text = tr("Drag items together, or tap two, to make something new.")
	var found: int = engine.found_count()
	var total: int = engine.total()
	count_label.text = tr("Discovered %d / %d") % [found, total]
	count_bar.max_value = total
	count_bar.value = found
	_refresh_hint_button()
	_rebuild_shelf()
	_refresh_table_hints()

func _refresh_hint_button() -> void:
	var n: int = engine.hints_available(_today())
	hint_btn.text = "💡 ∞" if n >= 999 else "💡 %d" % n

func _refresh_table_hints() -> void:
	for c in table.chips():
		c.set_hinted(engine.hint_view.has(c.item_id))

# ---------------------------------------------------------------- hints

func _on_hint() -> void:
	var r: Dictionary = engine.use_hint(_today())
	if not r.ok:
		_sfx("invalid")
		_toast(tr("No hints left today.") if r.reason == "none_left" else tr("Nothing to hint right now."), 2.0)
		return
	_sfx("pickup")
	if info:
		info.add("Hints used")
	var names: Array = []
	for id in r.ingredients:
		names.append(_label_of(id))
	if names.size() == 1:
		_toast(tr("Hint: something needs %s") % names[0], 3.0)
	else:
		_toast(tr("Hint: try %s with %s") % names, 3.0)
	search.text = ""
	sort_opt.select(0)
	tier_opt.select(0)
	_refresh_hint_button()
	_rebuild_shelf()
	_refresh_table_hints()
	scroll_timer.start()
	_save_game()

# ---------------------------------------------------------------- pause

func _on_pause() -> void:
	home.pause()

# ---------------------------------------------------------------- modals

func _open_modal(title: String) -> VBoxContainer:
	_close_modal()
	var ov := ColorRect.new()
	ov.color = Color(0, 0, 0, 0.62)
	ov.mouse_filter = Control.MOUSE_FILTER_STOP
	ov.theme = ui.theme
	ov.add_to_group("modal_overlay")
	home.add_child(ov)  # a child of the kit: Android back closes it (it looks for ColorRects with a "nav" meta)
	ov.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var center := CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	ov.add_child(center)
	var panel := PanelContainer.new()
	panel.custom_minimum_size = Vector2(minf(size.x - 32.0, 600.0), 0)
	center.add_child(panel)
	var scroll := ScrollContainer.new()
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	panel.add_child(scroll)
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 12)
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(box)
	var head := Label.new()
	head.text = title
	head.add_theme_font_size_override("font_size", 30)
	head.add_theme_color_override("font_color", pal.text)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(head)
	var close := Button.new()
	close.text = tr("Close")
	close.custom_minimum_size = Vector2(0, 60)
	close.pressed.connect(_close_modal)
	ov.set_meta("nav", close)
	ov.set_meta("temporary", true)
	_modal = ov
	box.set_meta("close", close)
	box.set_meta("scroll", scroll)
	return box

func _finish_modal(box: VBoxContainer) -> void:
	box.add_child(box.get_meta("close"))
	var scroll: ScrollContainer = box.get_meta("scroll")
	scroll.custom_minimum_size.y = clampf(box.get_combined_minimum_size().y + 4.0, 120.0, maxf(160.0, size.y - 140.0))

func _close_modal() -> void:
	if _modal != null and is_instance_valid(_modal):
		_modal.hide()
		_modal.queue_free()
	_modal = null

func _body_label(text: String, color: Color = Color(), size_px: int = 20) -> Label:
	var l := Label.new()
	l.text = text
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.add_theme_font_size_override("font_size", size_px)
	l.add_theme_color_override("font_color", color if color.a > 0.0 else pal.text)
	return l

# ---------------------------------------------------------------- collection

func _show_collection() -> void:
	var box := _open_modal(tr("Collection"))
	box.add_child(_body_label(tr("Discovered %d / %d") % [engine.found_count(), engine.total()], pal.text, 22))
	for t in engine.tiers:
		var id: int = int(t.id)
		var p: Array = engine.tier_progress(id)
		var locked: bool = not engine.tier_open(id)
		var row := VBoxContainer.new()
		row.add_theme_constant_override("separation", 4)
		box.add_child(row)
		var title := _body_label("%s%s" % ["🔒 " if locked else "", tr("Tier %d: %d/%d") % [id, p[0], p[1]]] + " · " + engine.tier_name(id, lang), pal.dim if locked else pal.text, 20)
		row.add_child(title)
		var bar := ProgressBar.new()
		bar.show_percentage = false
		bar.max_value = maxi(1, p[1])
		bar.value = p[0]
		bar.custom_minimum_size = Vector2(0, 14)
		bar.add_theme_stylebox_override("background", _flat(pal.panel, pal.border, 2, 6))
		bar.add_theme_stylebox_override("fill", _flat(pal.dim if locked else pal.accent, pal.accent, 0, 6))
		row.add_child(bar)
	if engine.paywall_on and not engine.has_full():
		var unlock := Button.new()
		unlock.text = tr("Unlock the Full Game")
		unlock.custom_minimum_size = Vector2(0, 60)
		unlock.pressed.connect(_show_unlock)
		box.add_child(unlock)
	_finish_modal(box)

# ---------------------------------------------------------------- settings

func _show_settings() -> void:
	var box := _open_modal(tr("Settings"))
	box.add_child(_body_label(tr("Item names"), pal.text, 22))
	box.add_child(_segmented([tr("Auto"), "English", "Español"], ["auto", "en", "es"], str(engine.settings.lang), _on_lang_pick))
	box.add_child(_body_label(tr("Item and tier names only. The app's language is in Options."), pal.dim, 17))
	box.add_child(_body_label(tr("Theme"), pal.text, 22))
	box.add_child(_segmented([tr("Auto"), tr("Dark"), tr("Light")], ["auto", "dark", "light"], str(engine.settings.theme), _on_theme_pick))
	if skin == "voodoo":
		box.add_child(_body_label(tr("The Voodoo look is always dark."), pal.dim, 17))
	if engine.paywall_on and not engine.has_full():
		var unlock := Button.new()
		unlock.text = tr("Unlock the Full Game")
		unlock.custom_minimum_size = Vector2(0, 60)
		unlock.pressed.connect(_show_unlock)
		box.add_child(unlock)
	var reset := Button.new()
	reset.text = tr("Reset progress")
	reset.custom_minimum_size = Vector2(0, 60)
	reset.pressed.connect(_confirm_reset)
	box.add_child(reset)
	_finish_modal(box)

func _segmented(labels: Array, values: Array, current: String, handler: Callable) -> HBoxContainer:
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	for i in labels.size():
		var b := Button.new()
		b.text = labels[i]
		b.toggle_mode = true
		b.button_pressed = values[i] == current
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		b.custom_minimum_size = Vector2(0, 56)
		b.pressed.connect(handler.bind(values[i]))
		row.add_child(b)
	return row

func _on_lang_pick(value: String) -> void:
	engine.settings.lang = value
	lang = engine.resolve_lang(TranslationServer.get_locale())
	_rename_everything()
	_save_game()
	_show_settings()

func _on_theme_pick(value: String) -> void:
	engine.settings.theme = value
	_set_skin(skin)
	_save_game()
	_show_settings()

## Item names changed language: redraw chips, shelf and tier filter.
func _rename_everything() -> void:
	for c in table.chips():
		c.name_label.text = engine.name_of(c.item_id, lang)
	_fill_tier_options()
	_rebuild_shelf()

func _confirm_reset() -> void:
	var box := _open_modal(tr("Reset progress"))
	box.add_child(_body_label(tr("Forget every discovery and start again with the four elements? Your settings stay. This can't be undone."), pal.text, 20))
	var yes := Button.new()
	yes.text = tr("Yes, reset")
	yes.custom_minimum_size = Vector2(0, 60)
	yes.pressed.connect(_do_reset)
	box.add_child(yes)
	_finish_modal(box)

func _do_reset() -> void:
	_close_modal()
	table.select(null)
	for c in table.chips():
		_remove_chip(c, false)
	engine.reset_progress()
	search.text = ""
	_refresh_all()
	_save_game()
	_toast(tr("Progress reset."), 2.0)

# ---------------------------------------------------------------- unlock (Full Game)

func _show_unlock() -> void:
	var extra: int = 0
	for t in engine.tiers:
		if not Gate.tier_is_free(int(t.id)):
			extra += engine.tier_progress(int(t.id))[1]
	var box := _open_modal(tr("Full Game"))
	box.add_child(_body_label(tr("Unlock everything with one purchase:"), pal.text, 22))
	box.add_child(_body_label("• " + tr("Tiers 4 and 5: %d more items") % extra, pal.text, 20))
	box.add_child(_body_label("• " + tr("Unlimited hints"), pal.text, 20))
	box.add_child(_body_label(tr("One-time purchase. No ads, no subscription."), pal.dim, 18))
	var buy := Button.new()
	buy.text = tr("Unlock the Full Game")
	buy.custom_minimum_size = Vector2(0, 64)
	buy.pressed.connect(_on_buy)
	box.add_child(buy)
	var restore := Button.new()
	restore.text = tr("Restore purchase")
	restore.custom_minimum_size = Vector2(0, 56)
	restore.pressed.connect(_on_restore)
	box.add_child(restore)
	_finish_modal(box)

func _on_buy() -> void:
	if Gate.store_buy(get_node_or_null("/root/Store")):
		_close_modal()
		return
	if OS.get_environment("VOODOO_CREATION_PAYWALL") == "1":
		# desktop testing only (VOODOO_CREATION_PAYWALL=1): pretend the purchase went through
		engine.set_full_purchased(true)
		_after_unlock()
		return
	_toast(tr("Purchases aren't available in this version."), 3.0)
	_close_modal()

func _on_restore() -> void:
	engine.owns_full = Gate.store_owns(get_node_or_null("/root/Store"))
	if engine.has_full():
		_after_unlock()
	else:
		_toast(tr("No purchase found."), 2.5)
		_close_modal()

func _after_unlock() -> void:
	_close_modal()
	var got: Array = engine.refresh_unlock()
	_refresh_all()
	_save_game()
	if info:
		info.high("Discoveries", engine.found_count())
	_toast(tr("Unlocked! %d items collected.") % got.size() if not got.is_empty() else tr("Unlocked!"), 3.0)
