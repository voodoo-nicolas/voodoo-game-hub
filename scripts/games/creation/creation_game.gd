# ---------------------------------------------------------------- chips

## A tile with an emoji and a name. Used on the table and on the shelf.
class Chip extends Control:
	var item_id: String = ""
	var frac := Vector2(0.5, 0.5)  # position on the table, 0..1 of the free space
	var state: String = "normal"   # normal | selected | target | bad | locked
	var hinted: bool = false
	var dying: bool = false
	var pal: Dictionary = {}
	var emoji_label: Label
	var name_label: Label
	var mark: Label

	func setup(id: String, emoji: String, title: String, p: Dictionary, chip_size: Vector2) -> void:
		item_id = id
		pal = p
		custom_minimum_size = chip_size
		size = chip_size
		pivot_offset = chip_size / 2.0
		mouse_filter = Control.MOUSE_FILTER_IGNORE
		emoji_label = Label.new()
		emoji_label.text = emoji
		emoji_label.add_theme_font_size_override("font_size", int(chip_size.y * 0.42))
		emoji_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		emoji_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		emoji_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		emoji_label.position = Vector2(0, 2)
		emoji_label.size = Vector2(chip_size.x, chip_size.y * 0.56)
		add_child(emoji_label)
		name_label = Label.new()
		name_label.text = title
		var longest: int = 0
		for w in title.split(" "):
			longest = maxi(longest, w.length())
		name_label.add_theme_font_size_override("font_size", 17 if longest <= 9 else (14 if longest <= 12 else 12))
		name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		name_label.vertical_alignment = VERTICAL_ALIGNMENT_TOP
		name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		name_label.max_lines_visible = 2
		name_label.clip_text = true
		name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		name_label.position = Vector2(4, chip_size.y * 0.56)
		name_label.size = Vector2(chip_size.x - 8, chip_size.y * 0.42)
		add_child(name_label)
		mark = Label.new()
		mark.text = "×"
		mark.add_theme_font_size_override("font_size", int(chip_size.y * 0.7))
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
		mark.size = chip_size
		mark.visible = false
		add_child(mark)
		restyle(p)

	func restyle(p: Dictionary) -> void:
		pal = p
		name_label.add_theme_color_override("font_color", pal.text)
		emoji_label.add_theme_color_override("font_color", pal.text)
		mark.add_theme_color_override("font_color", pal.bad)
		_apply_state()

	func set_state(s: String) -> void:
		if s == state:
			return
		state = s
		_apply_state()

	func set_hinted(on: bool) -> void:
		hinted = on
		queue_redraw()

	func _apply_state() -> void:
		var dim: bool = state == "bad" or state == "locked"
		emoji_label.modulate = Color(1, 1, 1, 0.35 if dim else 1.0)
		name_label.modulate = Color(1, 1, 1, 0.5 if dim else 1.0)
		mark.visible = state == "bad"
		queue_redraw()

	func _draw() -> void:
		var sb := StyleBoxFlat.new()
		sb.bg_color = pal.chip
		sb.border_color = pal.border
		sb.set_border_width_all(2)
		sb.set_corner_radius_all(16)
		match state:
			"selected":
				sb.border_color = pal.accent
				sb.set_border_width_all(5)
			"target":
				sb.border_color = pal.good
				sb.set_border_width_all(5)
			"bad":
				sb.border_color = pal.bad
				sb.set_border_width_all(4)
			"locked":
				sb.bg_color = pal.panel
				sb.border_color = pal.dim
		if hinted:
			sb.border_color = pal.hint
			sb.set_border_width_all(5)
			sb.shadow_color = Color(pal.hint, 0.55)
			sb.shadow_size = 10
		draw_style_box(sb, Rect2(Vector2.ZERO, size))

# ---------------------------------------------------------------- table

## The play area. Hit-tests its chips itself (they ignore the mouse), so one
## place decides tap / drag / double-tap / trash.
class Table extends Control:
	signal combine_requested(a, b)
	signal tapped(chip)
	signal duplicated(chip)
	signal removed(chip)
	signal arranged
	signal clear_pressed

	var pal: Dictionary = {}
	var is_bad: Callable = Callable()  # (id_a, id_b) -> bool: this pair already failed
	var drag = null
	var selected = null
	var target = null
	var moved: bool = false
	var drag_off := Vector2.ZERO
	var press_pos := Vector2.ZERO
	var trash_rect := Rect2()
	var trash_hot: bool = false
	var last_tap_chip = null
	var last_tap_ms: int = 0
	var trash_label: Label
	var clear_btn: Button

	func _init() -> void:
		clip_contents = true
		mouse_filter = Control.MOUSE_FILTER_STOP
		trash_label = Label.new()
		trash_label.text = "🗑"
		trash_label.add_theme_font_size_override("font_size", 38)
		trash_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		trash_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		trash_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		add_child(trash_label)
		clear_btn = Button.new()
		clear_btn.text = "Clear"
		clear_btn.custom_minimum_size = Vector2(110, 54)
		clear_btn.add_theme_font_size_override("font_size", 22)
		clear_btn.pressed.connect(_on_clear)
		add_child(clear_btn)

	func _on_clear() -> void:
		clear_pressed.emit()

	func _notification(what: int) -> void:
		if what == NOTIFICATION_RESIZED:
			trash_rect = Rect2(10, size.y - 74, 64, 64)
			trash_label.position = trash_rect.position
			trash_label.size = trash_rect.size
			clear_btn.size = Vector2(110, 54)
			clear_btn.position = Vector2(size.x - 120, size.y - 64)
			for c in chips():
				place(c)
			queue_redraw()

	func chips() -> Array:
		var out: Array = []
		for c in get_children():
			if c is Chip and not c.dying:
				out.append(c)
		return out

	func chip_at(p: Vector2):
		var kids := get_children()
		for i in range(kids.size() - 1, -1, -1):
			var c = kids[i]
			if c is Chip and not c.dying and Rect2(c.position, c.size).has_point(p):
				return c
		return null

	## Puts a chip where its fractions say (the table may have been resized).
	func place(c: Chip) -> void:
		var free: Vector2 = (size - c.size).max(Vector2.ZERO)
		c.position = Vector2(c.frac.x * free.x, c.frac.y * free.y)

	func fraction_of(pos: Vector2, c: Chip) -> Vector2:
		var free: Vector2 = (size - c.size).max(Vector2(1, 1))
		return Vector2(clampf(pos.x / free.x, 0.0, 1.0), clampf(pos.y / free.y, 0.0, 1.0))

	## The chip that `rect` overlaps most (or whose body holds its centre).
	func target_for(rect: Rect2, ignore):
		var best = null
		var best_score := 0.0
		for o in chips():
			if o == ignore:
				continue
			var orect := Rect2(o.position, o.size)
			var inter := rect.intersection(orect)
			var score := (inter.size.x * inter.size.y) / (rect.size.x * rect.size.y) if inter.has_area() else 0.0
			if orect.has_point(rect.get_center()):
				score = maxf(score, 0.5)
			if score > 0.28 and score > best_score:
				best = o
				best_score = score
		return best

	func set_target(t, dragged_id: String = "") -> void:
		if t == target:
			return
		if target != null and is_instance_valid(target) and target != selected:
			target.set_state("normal")
		target = t
		if target != null:
			var bad: bool = is_bad.is_valid() and bool(is_bad.call(dragged_id, target.item_id))
			target.set_state("bad" if bad else "target")

	func select(c) -> void:
		if selected != null and is_instance_valid(selected):
			selected.set_state("normal")
		selected = c
		if c != null:
			c.set_state("selected")

	func free_spot(c: Chip) -> Vector2:
		# first free grid cell, left to right, top to bottom
		var step := Vector2(c.size.x + 10, c.size.y + 10)
		var cols := maxi(1, int((size.x - 20) / step.x))
		var rows := maxi(1, int((size.y - 90) / step.y))
		for r in rows:
			for q in cols:
				var pos := Vector2(10 + q * step.x, 10 + r * step.y)
				if target_for(Rect2(pos, c.size), c) == null:
					return pos
		return Vector2(randf_range(10, maxf(11, size.x - c.size.x - 10)), randf_range(10, maxf(11, size.y - c.size.y - 80)))

	func _gui_input(event: InputEvent) -> void:
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				var c = chip_at(event.position)
				if c == null:
					tapped.emit(null)
					return
				drag = c
				drag_off = event.position - c.position
				press_pos = event.position
				moved = false
				move_child(c, get_child_count() - 1)
				accept_event()
			elif drag != null:
				_release(event.position)
				accept_event()
		elif event is InputEventMouseMotion and drag != null and (event.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
			if not moved and event.position.distance_to(press_pos) > 10.0:
				moved = true
				drag.scale = Vector2(1.07, 1.07)
			if moved:
				drag.position = (event.position - drag_off).clamp(Vector2.ZERO, (size - drag.size).max(Vector2.ZERO))
				trash_hot = trash_rect.has_point(event.position)
				set_target(null if trash_hot else target_for(Rect2(drag.position, drag.size), drag), drag.item_id)
				queue_redraw()
			accept_event()

	func _release(pos: Vector2) -> void:
		var c = drag
		drag = null
		if not is_instance_valid(c):
			return
		c.scale = Vector2.ONE
		var t = target
		set_target(null)
		var over_trash := trash_rect.has_point(pos)
		trash_hot = false
		queue_redraw()
		if moved:
			if over_trash:
				removed.emit(c)
			elif t != null and is_instance_valid(t):
				combine_requested.emit(c, t)
			else:
				c.frac = fraction_of(c.position, c)
				arranged.emit()
		else:
			var now := Time.get_ticks_msec()
			if last_tap_chip == c and is_instance_valid(c) and now - last_tap_ms < 350:
				last_tap_chip = null
				duplicated.emit(c)
			else:
				last_tap_chip = c
				last_tap_ms = now
				tapped.emit(c)

	func _draw() -> void:
		if pal.is_empty():
			return
		var sb := StyleBoxFlat.new()
		sb.bg_color = pal.table
		sb.border_color = pal.border
		sb.set_border_width_all(2)
		sb.set_corner_radius_all(20)
		draw_style_box(sb, Rect2(Vector2.ZERO, size))
		var tc: Color = pal.bad if trash_hot else pal.dim
		draw_circle(trash_rect.get_center(), 34.0, Color(tc, 0.35 if trash_hot else 0.18))
		draw_arc(trash_rect.get_center(), 34.0, 0.0, TAU, 40, Color(tc, 0.9), 2.0)

# ---------------------------------------------------------------- shelf input

## Taps, scrolling and drags on the shelf. The shelf chips ignore the mouse
## and this reads raw input (like scripts/common/drag_scroll.gd), so one place
## decides: a tap adds the item to the table, a drag (mouse: straight away;
## touch: after a short hold) carries it there, anything else scrolls.
class ShelfDrag extends Node:
	const IDLE := 0
	const PRESSED := 1
	const SCROLL := 2
	const DRAG := 3
	const HOLD_SECONDS := 0.28
	var game
	var state: int = IDLE
	var item = null
	var press_pos := Vector2.ZERO
	var last_pos := Vector2.ZERO
	var start_scroll: int = 0
	var touch: bool = false
	var hold: Timer

	func _ready() -> void:
		touch = DisplayServer.is_touchscreen_available()
		hold = Timer.new()
		hold.one_shot = true
		hold.wait_time = HOLD_SECONDS
		hold.timeout.connect(_on_hold)
		add_child(hold)

	func _on_hold() -> void:
		if state == PRESSED and item != null and is_instance_valid(item):
			_start_drag()

	func _start_drag() -> void:
		state = DRAG
		game.shelf_drag_begin(item, last_pos)

	func _input(event: InputEvent) -> void:
		if game == null:
			return
		if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
			if event.pressed:
				state = IDLE
				if game.modal_open() or not game.shelf_scroll.is_visible_in_tree():
					return
				if not game.shelf_scroll.get_global_rect().has_point(event.position):
					return
				item = game.shelf_item_at(event.position)
				state = PRESSED
				press_pos = event.position
				last_pos = event.position
				start_scroll = game.shelf_scroll.scroll_vertical
				if item != null and touch:
					hold.start()
			else:
				hold.stop()
				var s := state
				state = IDLE
				if s == PRESSED and item != null and is_instance_valid(item):
					game.shelf_tap(item)
				elif s == DRAG:
					game.shelf_drag_end(item, event.position)
				item = null
		elif event is InputEventMouseMotion and state != IDLE and (event.button_mask & MOUSE_BUTTON_MASK_LEFT) != 0:
			last_pos = event.position
			if state == PRESSED:
				if event.position.distance_to(press_pos) > 14.0:
					hold.stop()
					if item != null and not touch and is_instance_valid(item):
						_start_drag()
					elif touch:
						state = SCROLL
			if state == SCROLL:
				game.shelf_scroll.scroll_vertical = start_scroll - int(event.position.y - press_pos.y)
			elif state == DRAG:
				game.shelf_drag_move(item, event.position)

# ---------------------------------------------------------------- setup

func _ready() -> void:
	preload("res://scripts/games/creation/creation_i18n.gd").install(self)
	Orientation.lock_portrait()
	engine = CreationEngine.new()
	var errs: Array = engine.load_data(CreationEngine.parse_data(FileAccess.get_file_as_string(DATA_PATH)))
	if not errs.is_empty():
		push_error("Creation data failed validation: " + str(errs.slice(0, 5)))
	engine.paywall_on = Gate.live()
	engine.owns_full = Gate.store_owns(get_node_or_null("/root/Store"))
	var raw = SaveUtil.read(SAVE_PATH)
	if raw != null:
		engine.from_save(raw)
	lang = engine.resolve_lang(TranslationServer.get_locale())
	if ResourceLoader.exists(GAME_INFO_PATH):
		info = load(GAME_INFO_PATH).new(Help)
	_build_ui()
	_build_home()
	_set_skin(skin)
	_restore_workspace()
	_refresh_all()
	loaded = true

