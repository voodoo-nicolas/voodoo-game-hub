static func get_quest(id: String) -> Dictionary:
	for q in LIST:
		if q.id == id:
			return q
	return {}

static func quest_name(q: Dictionary) -> String:
	return str(q.get("es" if TranslationServer.get_locale().begins_with("es") else "en", q.id))

