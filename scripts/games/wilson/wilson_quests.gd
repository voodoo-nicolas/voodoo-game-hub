static func daily(id: String) -> Dictionary:
	for q in DAILY:
		if q.id == id:
			return q
	return {}

static func daily_name(q: Dictionary) -> String:
	return str(q.get("es" if TranslationServer.get_locale().begins_with("es") else "en", q.id))
