extends Control

## Rectangles (working title Gridmaster) -- split the grid into rectangles, each holding
## one number equal to its size. Drag corner to corner to draw; tap a rectangle to remove.
## Modes: Classic levels (stars), Daily (7x7, same for everyone), Weekly (10x10), Zen.

const Engine_ = preload("res://scripts/games/rectangles/rectangles_engine.gd")
const Gen = preload("res://scripts/games/rectangles/rectangles_generator.gd")
const HELP = preload("res://scripts/games/rectangles/rectangles_help.gd")
const HomeKit = preload("res://scripts/games/rectangles/home_kit.gd")
const Orientation = preload("res://scripts/common/orientation.gd")
const SaveUtil = preload("res://scripts/common/save_util.gd")
const UI = preload("res://scripts/common/ui.gd")
## How to Play + stats. Not preloaded: older apps may not have it.
const GAME_INFO_PATH := "res://scripts/common/game_info.gd"
## Generated by `python tools/hub.py i18n`; loaded only if present.
const I18N_PATH := "res://scripts/games/rectangles/rectangles_i18n.gd"
## Classic levels written by tools/rectangles_gen.gd; any level missing here is generated
## from the same seed at runtime, so the game also works without the file.
const LEVELS_PATH := "res://games/rectangles/levels/classic_1.json"

const SAVE_PATH := "user://rectangles_save.json"
const PROGRESS_PATH := "user://rectangles_progress.json"
const PREFS_PATH := "user://rectangles_prefs.json"
const CLASSIC_LEVELS := 300
const ZEN := [["🙂 Easy", 5, 0], ["😐 Normal", 6, 1], ["😈 Hard", 8, 2], ["🤯 Expert", 10, 3]]

## Classic look (owner, 2026-11-12: bright): light sky backdrop, white board, vivid fills.
## Original palette. Voodoo is the dark neon view.
const SKY := Color("e3f2ff")
const PAPER := Color("ffffff")
const LINE := Color("d5dde8")
const INK := Color("1f2a3a")
const FILLS := [Color("ff6b6b"), Color("ffa94d"), Color("ffd43b"), Color("69db7c"), Color("38d9a9"),
	Color("4dabf7"), Color("748ffc"), Color("b197fc"), Color("f783ac"), Color("a9e34b")]
const NEON := [Color("27e0d0"), Color("ff5fa2"), Color("ffd23f"), Color("8cff5a"), Color("b36bff"),
	Color("38b6ff"), Color("ff8a3d"), Color("f2f2f2"), Color("5affc8"), Color("ff4f4f")]

var info = null  # GameInfo; null on apps without it
var home  # HomeKit
var engine: Engine_
var bg: ColorRect
var skin: String = "classic"
var title_label: Label
var count_label: Label
var info_label: Label
var feedback_label: Label
var board: Control
var end_dialog: ColorRect
var feedback_timer: Timer
var hint_btn: Button
var my_buttons: Array = []  # pause + action row: solid blue in the bright view

var mode: String = "classic"  # classic | daily | weekly | zen
var level: int = 1
var zen_tier: int = 0
var day: int = 0
var elapsed: float = 0.0
var hints_used: int = 0
var playing: bool = false
var progress: Dictionary = {}
var factor_helper: bool = true
var tutorial: int = 0  # 1 = "drag", 2 = "tap to remove", 0 = off

var drag_from := Vector2i(-1, -1)
var drag_to := Vector2i(-1, -1)
var hint_rc: Array = []
var hint_t: float = 0.0
var pop_rc: Array = []
var pop_t: float = 0.0
var shake_t: float = 0.0

func _ready() -> void:
	if ResourceLoader.exists(I18N_PATH):
		load(I18N_PATH).install(self)
	Orientation.lock_portrait()
	engine = Engine_.new()
	_load_progress()
	var prefs = SaveUtil.read(PREFS_PATH)
	if prefs is Dictionary:
		factor_helper = bool(prefs.get("factor_helper", true))
	_build_ui()
	_calm_music()

func _calm_music() -> void:
	var m = get_node_or_null("/root/Music")
	if m:
		m.play("calm", self, 1, 2.0)

func _build_ui() -> void:
	set_anchors_preset(Control.PRESET_FULL_RECT)
	theme = HomeKit.neon_theme()
	bg = HomeKit.backdrop()
	add_child(bg)

	var root := VBoxContainer.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.add_theme_constant_override("separation", 8)
	add_child(root)

	var top := MarginContainer.new()
	top.add_theme_constant_override("margin_top", 20)
	top.add_theme_constant_override("margin_left", 16)
	top.add_theme_constant_override("margin_right", 16)
	root.add_child(top)
	var bar := HBoxContainer.new()
	bar.add_theme_constant_override("separation", 10)
	top.add_child(bar)
	var pause_btn := Button.new()
	pause_btn.text = "⏸"
	pause_btn.custom_minimum_size = Vector2(76, 64)
	pause_btn.add_theme_font_size_override("font_size", 30)
	pause_btn.pressed.connect(_on_pause_home)
	bar.add_child(pause_btn)
	my_buttons.append(pause_btn)
	title_label = Label.new()
	title_label.add_theme_font_size_override("font_size", 30)
	title_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_label.clip_text = true
	bar.add_child(title_label)
	count_label = Label.new()
	count_label.add_theme_font_size_override("font_size", 30)
	count_label.custom_minimum_size = Vector2(96, 0)
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	bar.add_child(count_label)

	info_label = Label.new()
	info_label.add_theme_font_size_override("font_size", 22)
	info_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	root.add_child(info_label)

	var bm := MarginContainer.new()
	bm.size_flags_vertical = Control.SIZE_EXPAND_FILL
	bm.add_theme_constant_override("margin_left", 10)
	bm.add_theme_constant_override("margin_right", 10)
	root.add_child(bm)
	board = Control.new()
	board.size_flags_vertical = Control.SIZE_EXPAND_FILL
	board.mouse_filter = Control.MOUSE_FILTER_STOP
	board.draw.connect(_draw_board)
	board.gui_input.connect(_on_board_input)
	board.resized.connect(board.queue_redraw)
	bm.add_child(board)

	feedback_label = Label.new()
	feedback_label.add_theme_font_size_override("font_size", 24)
	feedback_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	feedback_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	feedback_label.custom_minimum_size = Vector2(0, 64)
	root.add_child(feedback_label)

	var row_margin := MarginContainer.new()
	row_margin.add_theme_constant_override("margin_bottom", 30)
	row_margin.add_theme_constant_override("margin_left", 12)
	row_margin.add_theme_constant_override("margin_right", 12)
	root.add_child(row_margin)
	var actions := HBoxContainer.new()
	actions.add_theme_constant_override("separation", 10)
	row_margin.add_child(actions)
	actions.add_child(_button(tr("↶ Undo"), _on_undo))
	actions.add_child(_button(tr("⟲ Reset"), _on_reset))
	hint_btn = _button(tr("💡 Hint"), _on_hint)
	actions.add_child(hint_btn)

	feedback_timer = Timer.new()
	feedback_timer.one_shot = true
	feedback_timer.wait_time = 3.0
