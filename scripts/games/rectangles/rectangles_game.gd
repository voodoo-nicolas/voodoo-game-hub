	add_child(feedback_timer)

	end_dialog = UI.build_dialog(tr("Solved!"), [
		{"text": tr("Next puzzle"), "action": _next_puzzle},
		{"text": tr("🏠 %s Home") % tr(HELP.TITLE), "action": _go_home},
	], true)
	add_child(end_dialog)

	if ResourceLoader.exists(GAME_INFO_PATH):
		info = load(GAME_INFO_PATH).new(HELP)
	var modes: Array = [
		{"text": "🗺 Classic", "sub": "300 levels · collect stars", "color": HomeKit.GOLD, "action": _start_classic},
		{"text": "📅 Daily Challenge", "sub": "One 7 × 7 board a day, same for everyone", "color": HomeKit.PINK, "action": _start_daily},
		{"text": "🗓 Weekly Challenge", "sub": "One big 10 × 10 board a week", "color": HomeKit.PURPLE, "action": _start_weekly},
	]
	for i in ZEN.size():
		modes.append({"text": ZEN[i][0], "sub": "Zen · %d × %d" % [ZEN[i][1], ZEN[i][1]], "row": "zen", "key": "zen" + str(i),
			"action": _start_zen.bind(i)})
	home = HomeKit.new({
		"help": HELP,
		"info": info,
		"accent": HomeKit.CYAN,
		"subtitle": "Cut the grid into rectangles. Each number is its own size.",
		"logo": _draw_home_logo,
		"modes": modes,
		"save_path": SAVE_PATH,
		"resume": _load_saved_game,
		"resume_text": _resume_text,
		"restart": _restart,
		"options": _add_game_options,
		"helps": [{"text": "💡 Hint", "how": "Makes one correct rectangle blink.", "action": _hint_now}],
		"board": "Puzzles solved",
		"board_note": "Puzzles solved in any mode.",
	})
	add_child(home)
	home.track_help_button(hint_btn, "💡 Hint")
	if info:
		add_child(info)
	if skin == "classic":
		_set_skin("classic")  # the kit only calls _set_skin for Voodoo; paint the bright view now

func _button(text: String, action: Callable) -> Button:
	var b := Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(0, 72)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.add_theme_font_size_override("font_size", 26)
	b.pressed.connect(action)
	my_buttons.append(b)
	return b

## Bright view: solid blue buttons with white text (the neon theme is for the dark view).
func _style_buttons() -> void:
	for b in my_buttons:
		for st in ["normal", "hover", "pressed", "focus", "disabled"]:
			if skin == "classic":
				var sb := StyleBoxFlat.new()
				sb.bg_color = Color("2f74d0").darkened(0.15 if st == "pressed" else 0.0).lightened(0.08 if st == "hover" else 0.0)
				sb.set_corner_radius_all(18)
				sb.border_color = Color("1d4f96")
				sb.set_border_width_all(2)
				b.add_theme_stylebox_override(st, sb)
			else:
				b.remove_theme_stylebox_override(st)
		for fc in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			if skin == "classic":
				b.add_theme_color_override(fc, Color.WHITE)
			else:
				b.remove_theme_color_override(fc)
		if skin == "classic":
			b.add_theme_color_override("font_disabled_color", Color(1, 1, 1, 0.6))
		else:
			b.remove_theme_color_override("font_disabled_color")

## ⚙ Options → the factor helper (tap a bare number to see its shapes; no star cost).
func _add_game_options(body: VBoxContainer) -> void:
	body.add_child(home.section("Shape helper"))
	body.add_child(home.choice_row(["On", "Off"], 0 if factor_helper else 1, _pick_helper))
	body.add_child(HomeKit.label(tr("Tap a number without a rectangle to see every shape it can make."), 22, HomeKit.DIM, true))

func _pick_helper(i: int) -> void:
	factor_helper = i == 0
	SaveUtil.write(PREFS_PATH, {"factor_helper": factor_helper})

# ---------- looks ----------

func _set_skin(name: String) -> void:
	skin = "voodoo" if name == "voodoo" else "classic"
	if bg:
		bg.color = SKY if skin == "classic" else HomeKit.BG
		for ch in bg.get_children():  # neon grid + leather picture: dark view only
			ch.visible = skin != "classic"
	for l in [title_label, count_label, info_label]:
		if l:
			l.add_theme_color_override("font_color", INK if skin == "classic" else Color.WHITE)
	_style_buttons()
	if board:
		board.queue_redraw()

func _is_classic() -> bool:
	return skin == "classic"

func _fill(k: int) -> Color:
	return (FILLS if _is_classic() else NEON)[k % FILLS.size()]

func _update_hud() -> void:
	match mode:
		"classic":
			title_label.text = tr("Level %d") % level
		"daily":
			title_label.text = tr("📅 Daily Challenge")
		"weekly":
			title_label.text = tr("🗓 Weekly Challenge")
		_:
			title_label.text = tr(ZEN[zen_tier][0])
	count_label.text = "%d/%d" % [engine.placed_count(), engine.clues.size()]
	var t := int(elapsed)
	info_label.text = tr("Time %d:%02d   Hints %d") % [t / 60, t % 60, hints_used]

# ---------- board geometry ----------

func _cell_size() -> float:
	if engine.cols == 0:
		return 1.0
	return minf(board.size.x / engine.cols, board.size.y / engine.rows)

func _origin() -> Vector2:
	var s := _cell_size()
	var o := Vector2((board.size.x - s * engine.cols) / 2.0, (board.size.y - s * engine.rows) / 2.0)
	if shake_t > 0.0:
		o.x += sin(shake_t * 60.0) * 8.0 * shake_t / 0.3
	return o

func _rc_rect(rc: Array) -> Rect2:
	var s := _cell_size()
	return Rect2(_origin() + Vector2(rc[1] * s, rc[0] * s), Vector2(rc[3] * s, rc[2] * s))

func _cell_at(p: Vector2) -> Vector2i:
	var s := _cell_size()
	var q := (p - _origin()) / s
	return Vector2i(clampi(int(floor(q.x)), 0, engine.cols - 1), clampi(int(floor(q.y)), 0, engine.rows - 1))

func _inside(p: Vector2) -> bool:
	var s := _cell_size()
	return Rect2(_origin(), Vector2(engine.cols * s, engine.rows * s)).has_point(p)

# ---------- drawing ----------

func _draw_board() -> void:
	if engine == null or engine.rows == 0:
		return
	var s := _cell_size()
	var font: Font = ThemeDB.fallback_font
	var area := Rect2(_origin(), Vector2(engine.cols * s, engine.rows * s))
	var classic := _is_classic()
	var line := LINE if classic else Color(HomeKit.CYAN, 0.25)
	board.draw_rect(area, PAPER if classic else Color(0, 0, 0, 0.55))
	# placed rectangles
	for rc in engine.placed:
		var k: int = engine.clue_of(rc)
		var r := _rc_rect(rc)
		if rc == pop_rc and pop_t > 0.0:
			r = r.grow(s * 0.08 * sin(pop_t / 0.25 * PI))
		var col := _fill(k)
		board.draw_rect(r.grow(-1.5), Color(col, 0.78 if classic else 0.28))
		board.draw_rect(r.grow(-1.5), INK if classic else col, false, 4.0 if classic else 3.0)
	# grid
	for c in range(engine.cols + 1):
		board.draw_line(area.position + Vector2(c * s, 0), area.position + Vector2(c * s, area.size.y), line, 2.0)
	for r in range(engine.rows + 1):
		board.draw_line(area.position + Vector2(0, r * s), area.position + Vector2(area.size.x, r * s), line, 2.0)
	board.draw_rect(area, INK if classic else HomeKit.CYAN, false, 3.0)
	# live preview while dragging
	if drag_from.x >= 0:
		var rc: Array = engine.rect_from(drag_from, drag_to)
		var k: int = engine.clue_of(rc)
		var r := _rc_rect(rc).grow(-3.0)
		if k >= 0:
			board.draw_rect(r, Color(_fill(k), 0.55))
			board.draw_rect(r, _fill(k).darkened(0.3) if classic else _fill(k), false, 4.0)
		else:
			board.draw_rect(r, Color(0.9, 0.2, 0.2, 0.10))
			board.draw_rect(r, Color("c0392b") if classic else Color("ff4f4f"), false, 4.0)
		var size_txt := "%d × %d" % [rc[3], rc[2]]
		var fs := int(clampf(s * 0.32, 16.0, 26.0))
		board.draw_string(font, r.position + Vector2(6, fs + 2), size_txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, INK if classic else Color.WHITE)
	# hint: a blinking outline (nothing is placed)
	if hint_t > 0.0 and not hint_rc.is_empty():
		var a := 0.5 + 0.5 * sin(hint_t * 10.0)
		board.draw_rect(_rc_rect(hint_rc).grow(-4.0), Color(HomeKit.GOLD if not classic else Color("d35400"), a), false, 6.0)
	# clues on top
	for cl in engine.clues:
		var cr := Rect2(area.position + Vector2(cl.c * s, cl.r * s), Vector2(s, s))
		var fs2 := int(s * 0.5)
		var txt := str(cl.n)
		var w: float = font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs2).x
		var covered: bool = engine.placed_at(Vector2i(cl.c, cl.r)) >= 0
		if not covered:
			board.draw_circle(cr.get_center(), s * 0.36, Color(INK, 0.08) if classic else Color(HomeKit.CYAN, 0.12))
		board.draw_string(font, Vector2(cr.get_center().x - w / 2.0, cr.get_center().y + fs2 * 0.36), txt,
			HORIZONTAL_ALIGNMENT_LEFT, -1, fs2, INK if classic else Color.WHITE)

func _draw_home_logo(c: Control) -> void:
	var k := minf(c.size.y * 0.22, 36.0)
	var o := c.size / 2.0 - Vector2(2.5 * k, 2.0 * k)
	# an original 5 x 4 split: [r, c, h, w, clue]
	var parts := [[0, 0, 2, 2, 4], [0, 2, 1, 3, 3], [1, 2, 2, 1, 2], [1, 3, 3, 2, 6], [2, 0, 2, 2, 4], [3, 2, 1, 1, 1]]
	var cols := [HomeKit.CYAN, HomeKit.PINK, HomeKit.GOLD, HomeKit.LIME, HomeKit.PURPLE, HomeKit.CYAN]
	for i in parts.size():
		var p: Array = parts[i]
		var rect := Rect2(o + Vector2(p[1] * k, p[0] * k), Vector2(p[3] * k, p[2] * k)).grow(-3.0)
		HomeKit.glow_rect(c, rect, cols[i], 2.0, 0.15)
		HomeKit.glow_text(c, o + Vector2((p[1] + 0.5) * k, (p[0] + 0.5) * k), str(p[4]), int(k * 0.55), Color.WHITE)

# ---------- input ----------

func _on_board_input(event: InputEvent) -> void:
	if not playing or engine.solved():
		return
	# Phones send touch as emulated mouse too; mouse events alone cover touch + desktop.
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			if _inside(event.position):
				drag_from = _cell_at(event.position)
				drag_to = drag_from
				board.queue_redraw()
		elif drag_from.x >= 0:
			_finish_drag()
	elif event is InputEventMouseMotion and drag_from.x >= 0:
		var c := _cell_at(event.position)
		if c != drag_to:
			drag_to = c
			_sfx("tick")
			board.queue_redraw()

func _finish_drag() -> void:
	var a := drag_from
	var b := drag_to
	drag_from = Vector2i(-1, -1)
	var rc: Array = engine.rect_from(a, b)
	if a == b and (not engine.is_valid(rc) or engine.placed_at(a) >= 0):
		_on_tap(a)
	elif engine.place(rc):
		pop_rc = rc
		pop_t = 0.25
		hint_t = 0.0
		_sfx("place")
		_buzz(15)
		if tutorial == 1:
			tutorial = 2
			_feedback(tr("Tap a colored area to remove it if needed."), _ink_soft(), 4.0)
		_after_change()
		return
	else:
		var k: int = engine.clue_of(rc)
		if k < 0 or engine.placed.has(rc):
			shake_t = 0.3
			_sfx("invalid")
	board.queue_redraw()

func _on_tap(cell: Vector2i) -> void:
	if engine.remove_at(cell):
		_sfx("back")
		if tutorial == 2:
			tutorial = 0
			_clear_feedback()
		_after_change()
		return
	var k: int = engine.clue_at[cell.y * engine.cols + cell.x]
	if k >= 0 and factor_helper:
		var n: int = engine.clues[k].n
		var parts: Array = []
		for sh in Engine_.shapes(n):
			parts.append("%d × %d" % [sh.y, sh.x])
		_feedback("%d = %s" % [n, ", ".join(parts)], _ink_soft(), 4.0)

func _after_change() -> void:
	_update_hud()
	board.queue_redraw()
	_save_game()
	if engine.solved():
		_on_solved()

func _on_undo() -> void:
	if playing and engine.undo():
		_sfx("back")
		_after_change()

func _on_reset() -> void:
	if playing and engine.reset():
		_sfx("back")
		_after_change()

func _on_hint() -> void:
	home.try_help(_hint_now)

## 💡 help (STANDARDS §17): one correct rectangle blinks; nothing is placed.
func _hint_now() -> bool:
	if not playing or engine.solved():
		return false
	var rc := engine.hint_rect()
	if rc.is_empty():
		return false
	hint_rc = rc
	hint_t = 3.0
	hints_used += 1
	_sfx("powerup")
	_update_hud()
	_save_game()
	return true

func _process(delta: float) -> void:
	var redraw := false
	if playing and not engine.solved():
		elapsed += delta
		_update_hud()
	for v in ["hint_t", "pop_t", "shake_t"]:
		if get(v) > 0.0:
			set(v, maxf(0.0, get(v) - delta))
			redraw = true
	if redraw:
		board.queue_redraw()

# ---------- win ----------

func _par_time() -> float:
	return float(engine.rows * engine.cols) * 4.0

func _on_solved() -> void:
	playing = false
	drag_from = Vector2i(-1, -1)
	_sfx("win")
	SaveUtil.delete(SAVE_PATH)
	var stars := 1
	if hints_used == 0 and elapsed <= _par_time():
		stars = 3
	elif hints_used <= 1:
		stars = 2
	var note := ""
	match mode:
		"classic":
			var key := str(level)
			progress.stars[key] = maxi(int(progress.stars.get(key, 0)), stars)
			progress.next = maxi(int(progress.next), mini(level + 1, CLASSIC_LEVELS))
			note = "★".repeat(stars) + "☆".repeat(3 - stars)
		"daily":
			if int(progress.get("daily_day", -1)) != day:
				progress.daily_streak = int(progress.get("daily_streak", 0)) + 1 if int(progress.get("daily_day", -1)) == day - 1 else 1
				progress.daily_day = day
			note = tr("Daily streak: %d") % int(progress.daily_streak)
	_save_progress()
	if info:
		info.add("Puzzles solved")
		if hints_used == 0:
			info.add("No-hint solves")
		if mode == "classic":
			info.high("Classic levels", _levels_done())
			info.high("Classic stars", _total_stars())
		if mode == "daily":
			info.high("Daily streak", int(progress.daily_streak))
		if engine.rows == 7 and elapsed < 60.0:
			info.add("Fast 7x7 solves")
		info.best("Best time (%s)" % _mode_name(), elapsed, true)
		info.celebrate(tr("Solved!"))
	var t := int(elapsed)
	var msg := tr("Time %d:%02d   Hints %d") % [t / 60, t % 60, hints_used]
	if note != "":
		msg += "\n" + note
	end_dialog.get_meta("message_label").text = msg
	end_dialog.visible = true
	board.queue_redraw()

func _mode_name() -> String:
	match mode:
		"classic":
			return "%d×%d" % [engine.rows, engine.cols]
		"daily":
			return "Daily"
		"weekly":
			return "Weekly"
	return "Zen %d×%d" % [engine.rows, engine.cols]

func _levels_done() -> int:
	return progress.stars.size()

func _total_stars() -> int:
	var t := 0
	for k in progress.stars:
		t += int(progress.stars[k])
	return t

# ---------- puzzles ----------

static func _today() -> int:
	return int(Time.get_unix_time_from_system() / 86400.0)  # UTC day number

func _classic_puzzle(lvl: int) -> Dictionary:
	if FileAccess.file_exists(LEVELS_PATH):
		var data = JSON.parse_string(FileAccess.get_file_as_string(LEVELS_PATH))
		if data is Array and lvl - 1 < data.size() and data[lvl - 1] is Dictionary:
			return data[lvl - 1]
	var spec := Gen.classic_spec(lvl)
	var p := Gen.generate(spec["size"], spec["size"], spec["seed"], spec["tier"])
	p.id = "classic-%03d" % lvl
	return p

func _start_classic() -> void:
	_start_level(clampi(int(progress.get("next", 1)), 1, CLASSIC_LEVELS))

func _start_level(lvl: int) -> void:
	mode = "classic"
	level = lvl
	_begin(_classic_puzzle(lvl))
	if lvl == 1 and int(progress.stars.get("1", 0)) == 0:
		tutorial = 1
		_feedback(tr("Drag from corner to corner to make a colored area."), _ink_soft(), 0.0)

func _start_daily() -> void:
	mode = "daily"
	day = _today()
	var p := Gen.generate(7, 7, day * 7919 + 13, 1)
	p.id = "daily-%d" % day
	_begin(p)

func _start_weekly() -> void:
	mode = "weekly"
	var week := (_today() + 3) / 7  # weeks start on Monday (day 0 was a Thursday)
	var p := Gen.generate(10, 10, week * 104729 + 7, 3, true)
	p.id = "weekly-%d" % week
	_begin(p)

func _start_zen(i: int) -> void:
	mode = "zen"
	zen_tier = i
	var n: int = ZEN[i][1]
	var p := Gen.generate(n, n, randi(), ZEN[i][2], i == 3)
	p.id = "zen"
	_begin(p)

func _begin(p: Dictionary) -> void:
	SaveUtil.delete(SAVE_PATH)
	engine.load_puzzle(p)
	elapsed = 0.0
	hints_used = 0
	_begin_play()

func _begin_play() -> void:
	playing = true
	tutorial = 0
	hint_t = 0.0
	drag_from = Vector2i(-1, -1)
	end_dialog.visible = false
	_clear_feedback()
	_update_hud()
	board.queue_redraw()
	_save_game()

func _next_puzzle() -> void:
	match mode:
		"classic":
			_start_level(mini(level + 1, CLASSIC_LEVELS))
		"zen":
			_start_zen(zen_tier)
		_:
			_start_classic()

func _restart() -> void:
	var p := engine.puzzle_dict()
	_begin(p)

func _on_pause_home() -> void:
	home.pause()

func _go_home() -> void:
	home.go_home()

# ---------- feedback ----------

func _ink_soft() -> Color:
	return Color("2c5d8f") if _is_classic() else Color(0.95, 0.88, 0.6)

## `secs` 0 keeps the text until something replaces it (tutorial line).
func _feedback(text: String, col: Color, secs: float = 3.0) -> void:
	feedback_label.text = text
	feedback_label.add_theme_color_override("font_color", col)
	feedback_timer.stop()
	if secs > 0.0:
		feedback_timer.start(secs)

func _clear_feedback() -> void:
	if tutorial == 1:
		return
	feedback_label.text = ""

# ---------- save / progress ----------

func _load_progress() -> void:
	var d = SaveUtil.read(PROGRESS_PATH)
	progress = d if d is Dictionary else {}
	if not progress.has("stars") or not progress.stars is Dictionary:
		progress.stars = {}
	if not progress.has("next"):
		progress.next = 1

func _save_progress() -> void:
	SaveUtil.write(PROGRESS_PATH, progress)

func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST or what == NOTIFICATION_APPLICATION_PAUSED:
		_save_game()

func _save_game() -> void:
	if engine == null or not playing or engine.rows == 0 or engine.solved():
		return
	var d := engine.to_dict()
	d["mode"] = mode
	d["level"] = level
	d["zen"] = zen_tier
	d["day"] = day
	d["elapsed"] = elapsed
	d["hints"] = hints_used
	SaveUtil.write(SAVE_PATH, d)

func _resume_text() -> String:
	var d = SaveUtil.read(SAVE_PATH)
	if d == null:
		return ""
	var t := int(float(d.get("elapsed", 0.0)))
	return tr("Time %d:%02d") % [t / 60, t % 60]

func _load_saved_game() -> void:
	var d = SaveUtil.read(SAVE_PATH)
	if d == null or not engine.from_dict(d):
		_start_classic()
		return
	mode = str(d.get("mode", "classic"))
	level = int(d.get("level", 1))
	zen_tier = clampi(int(d.get("zen", 0)), 0, ZEN.size() - 1)
	day = int(d.get("day", 0))
	elapsed = float(d.get("elapsed", 0.0))
	hints_used = int(d.get("hints", 0))
	_begin_play()

func _sfx(sound: String) -> void:
	var s = get_node_or_null("/root/Sfx")
	if s:
		s.play(sound)

## A short buzz, when the player has vibration on (Settings, app v0.21+).
func _buzz(ms: int) -> void:
	var st = get_node_or_null("/root/Settings")
	if st and st.has_method("buzz"):
		st.buzz(ms)
