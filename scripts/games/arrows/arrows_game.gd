## A compact result card in the bottom-right corner. The layer is see-through and lets taps
## pass (only the card catches them), so the board stays visible behind it.
## Same API as UI.build_dialog: `.visible` and the "message_label" meta.
func _side_card(title_text: String, buttons: Array) -> ColorRect:
	var layer := ColorRect.new()
	layer.color = Color(0, 0, 0, 0)
	layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.visible = false
	var panel := PanelContainer.new()
	var sb: StyleBoxFlat = UI.panel_style().duplicate()
	sb.set_content_margin_all(16)
	panel.add_theme_stylebox_override("panel", sb)
	panel.mouse_filter = Control.MOUSE_FILTER_STOP
	layer.add_child(panel)
	panel.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_RIGHT, Control.PRESET_MODE_MINSIZE, 16)
	panel.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	panel.grow_vertical = Control.GROW_DIRECTION_BEGIN
	panel.offset_bottom -= 24.0
	panel.offset_top -= 24.0
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 8)
	panel.add_child(box)
	var t := Label.new()
	t.text = title_text
	t.add_theme_font_size_override("font_size", 28)
	t.add_theme_color_override("font_color", Color.WHITE)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var msg := Label.new()
	msg.add_theme_font_size_override("font_size", 20)
	msg.add_theme_color_override("font_color", Color(1, 0.84, 0.04))
	msg.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	msg.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	msg.custom_minimum_size = Vector2(240, 0)
	box.add_child(msg)
	layer.set_meta("message_label", msg)
	for spec in buttons:
		var b := Button.new()
		b.text = spec[0]
		b.custom_minimum_size = Vector2(240, 56)
		b.clip_text = true
		b.add_theme_font_size_override("font_size", 22)
		b.pressed.connect(UI._dismiss_then.bind(layer, spec[1]))
		box.add_child(b)
	return layer

func _button(text: String, action: Callable) -> Button:
	var b := Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(140, 46)
	b.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	b.add_theme_font_size_override("font_size", 20)
	b.pressed.connect(action)
	my_buttons.append(b)
	return b

## Bright view: solid navy buttons with white text (the neon theme is for the dark view).
func _style_buttons() -> void:
	for b in my_buttons:
		for st in ["normal", "hover", "pressed", "focus", "disabled"]:
			if skin == "classic":
				var sb := StyleBoxFlat.new()
				sb.bg_color = Color("2b3a8c").darkened(0.15 if st == "pressed" else 0.0).lightened(0.08 if st == "hover" else 0.0)
				sb.set_corner_radius_all(18)
				sb.border_color = INK
				sb.set_border_width_all(2)
				b.add_theme_stylebox_override(st, sb)
			else:
				b.remove_theme_stylebox_override(st)
		for fc in ["font_color", "font_hover_color", "font_pressed_color", "font_focus_color"]:
			if skin == "classic":
				b.add_theme_color_override(fc, Color.WHITE)
			else:
				b.remove_theme_color_override(fc)
		if skin == "classic":
			b.add_theme_color_override("font_disabled_color", Color(1, 1, 1, 0.6))
		else:
			b.remove_theme_color_override("font_disabled_color")

## ⚙ Options → arrow colours.
func _add_game_options(body: VBoxContainer) -> void:
	body.add_child(home.section("Arrow colors"))
	body.add_child(home.choice_row(["Ink", "Rainbow"], colors, _pick_colors))
	body.add_child(HomeKit.label(tr("Rainbow gives every arrow its own colour. Red still means a wrong tap."), 22, HomeKit.DIM, true))

func _pick_colors(i: int) -> void:
	colors = i
	prefs["colors"] = colors
	SaveUtil.write(PREFS_PATH, prefs)
	board.queue_redraw()

# ---------- looks ----------

func _set_skin(name: String) -> void:
	skin = "voodoo" if name == "voodoo" else "classic"
	if bg:
		bg.color = PAPER if skin == "classic" else HomeKit.BG
		for ch in bg.get_children():  # neon grid + picture: dark view only
			ch.visible = skin != "classic"
	if tex_bg:
		tex_bg.visible = skin == "classic"
	for l in [title_label, diff_label]:
		if l:
			l.add_theme_color_override("font_color", INK if skin == "classic" else Color.WHITE)
	_style_buttons()
	if board:
		board.queue_redraw()
	if hearts_box:
		hearts_box.queue_redraw()

func _is_classic() -> bool:
	return skin == "classic"

func _arrow_color(i: int) -> Color:
	if engine.arrows[i].red:
		return RED if _is_classic() else Color("ff4f4f")
	if _is_classic():
		return RAINBOW[(i * 7) % RAINBOW.size()] if colors == 1 else INK
	return NEON[(i * 5) % NEON.size()] if colors == 1 else HomeKit.CYAN

func _update_hud() -> void:
	match mode:
		"classic":
			title_label.text = tr("Level %d") % level
			diff_label.text = tr(Gen.difficulty(level))
			if clock:
				var t := int(ceil(maxf(time_left, 0.0)))
				diff_label.text = "⏱%d:%02d" % [t / 60, t % 60]
		"daily":
			title_label.text = tr("📅 Daily Challenge")
			diff_label.text = ""
		_:
			title_label.text = tr(ZEN[zen_tier][0])
			diff_label.text = tr("Zen")
	var low := clock and time_left <= 10.0
	diff_label.add_theme_color_override("font_color", RED if low else (INK if _is_classic() else Color.WHITE))
	hearts_box.queue_redraw()

## Seconds for this board: about 2 s per arrow at level 4, 1.2 s by the last level.
func _time_for() -> float:
	var k := clampf(float(level - 4) / float(Gen.LEVELS - 4), 0.0, 1.0)
	var t := 15.0 + engine.arrows.size() * lerpf(2.0, 1.2, k)
	return ceilf(t / 5.0) * 5.0

func _time_up() -> void:
	time_left = 0.0
	playing = false
	_sfx("lose")
	_buzz(60)
	SaveUtil.delete(SAVE_PATH)
	if info:
		info.result("loss")
	time_dialog.get_meta("message_label").text = tr("%d arrows left.") % engine.alive_count()
	time_dialog.visible = true
	_update_hud()

# ---------- view (fit, pinch, pan) ----------

func _fit_view() -> void:
	if engine == null or engine.cols == 0 or board.size.x < 2.0:
		return
	# _fit_vs = minf(board.size.x / (engine.cols + 0.6), board.size.y / (engine.rows + 0.6))
	_fit_vs = minf(board.size.x / (engine.cols + 1.6), board.size.y / (engine.rows + 1.6))  # room for the card edge
	var keep := zoom
	zoom = 1.0
	vs = _fit_vs
	vo = (board.size - Vector2(engine.cols, engine.rows) * vs) / 2.0
	if keep > 1.0:
		_zoom_at(board.size / 2.0, keep)
	board.queue_redraw()

func _zoom_max() -> float:
	return maxf(1.5, ZOOM_MAX_PX / _fit_vs)

func _zoom_reset() -> void:
	zoom = 1.0
	_fit_view()

## Zooms by `k` keeping the board point under `at` still.
func _zoom_at(at: Vector2, k: float) -> void:
	var nz := clampf(zoom * k, 1.0, _zoom_max())
	if absf(nz - zoom) < 0.0001:
		return
	var w := (at - vo) / vs
	zoom = nz
	vs = _fit_vs * zoom
	vo = at - w * vs
	_clamp_view()

func _pan(d: Vector2) -> void:
	if zoom <= 1.0001:
		return
	vo += d
	_clamp_view()

## Zoomed in, the picture's edges can't come inside the board (a margin of half a cell).
func _clamp_view() -> void:
	var content := Vector2(engine.cols, engine.rows) * vs
	var pad := vs * 0.3
	for ax in 2:
		if content[ax] + 2.0 * pad <= board.size[ax]:
			vo[ax] = (board.size[ax] - content[ax]) / 2.0
		else:
			vo[ax] = clampf(vo[ax], board.size[ax] - content[ax] - pad, pad)
	board.queue_redraw()

## Pinch / two-finger drag / wheel / right-drag. Returns true when the event moved the view.
func _zoom_input(event: InputEvent) -> bool:
	if event is InputEventScreenTouch:
		if event.pressed:
			_touches[event.index] = event.position
		else:
			_touches.erase(event.index)
		if _touches.size() >= 2:
			_pinching = true
			_pinched_since_press = true
			var pts: Array = _touches.values()
			_pinch_d = (pts[0] as Vector2).distance_to(pts[1])
			_pinch_mid = ((pts[0] as Vector2) + pts[1]) * 0.5
		elif _touches.is_empty():
			_pinching = false
		return _pinching
	if event is InputEventScreenDrag:
		_touches[event.index] = event.position
		if _touches.size() >= 2:
			var pts: Array = _touches.values()
			var d := (pts[0] as Vector2).distance_to(pts[1])
			var mid: Vector2 = ((pts[0] as Vector2) + pts[1]) * 0.5
			if _pinch_d > 1.0:
				_zoom_at(mid, d / _pinch_d)
			_pan(mid - _pinch_mid)
			_pinch_d = d
			_pinch_mid = mid
			return true
		return _pinching
	# While two fingers are down, the phone's emulated mouse events are ignored.
	if _pinching and (event is InputEventMouseButton or event is InputEventMouseMotion):
		return true
	if event is InputEventMouseButton:
		if event.pressed and event.button_index == MOUSE_BUTTON_WHEEL_UP:
			_zoom_at(event.position, 1.15)
			return true
		if event.pressed and event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			_zoom_at(event.position, 1.0 / 1.15)
			return true
		if event.button_index in [MOUSE_BUTTON_RIGHT, MOUSE_BUTTON_MIDDLE]:
			_pan_mouse = event.pressed
			return true
	if event is InputEventMouseMotion and _pan_mouse:
		_pan(event.relative)
		return true
	if event is InputEventMagnifyGesture:
		_zoom_at(event.position, event.factor)
		return true
	if event is InputEventPanGesture:
		_pan(-event.delta * 12.0)
		return true
	return false

# ---------- input ----------

func _on_board_input(event: InputEvent) -> void:
	if engine.cols == 0:
		return
	if _zoom_input(event):
		return
	# Phones send touch as emulated mouse too; mouse events alone cover touch + desktop taps.
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_mouse_down = true
			_panning = false
			_pinched_since_press = false
			_press_at = event.position
		elif _mouse_down:
			_mouse_down = false
			if not _panning and not _pinched_since_press and event.position.distance_to(_press_at) < TAP_SLOP:
				_on_tap(event.position)
			_panning = false
	elif event is InputEventMouseMotion and _mouse_down and zoom > 1.0001:
		# One finger drags the view when zoomed in.
		if _panning or event.position.distance_to(_press_at) >= TAP_SLOP:
			_panning = true
			_pan(event.relative)

func _arrow_at(p: Vector2) -> int:
	var q := (p - vo) / vs
	var c := Vector2i(int(floor(q.x)), int(floor(q.y)))
	var hit := engine.at(c)
	if hit >= 0 and not _animating(hit):
		return hit
	# Near a line? Take the closest arrow cell within reach (thin lines are hard to hit).
	var best := -1
	var best_d := 0.8
	for dy in range(-1, 2):
		for dx in range(-1, 2):
			var n := c + Vector2i(dx, dy)
			var i := engine.at(n)
			if i < 0 or _animating(i):
				continue
			var d := q.distance_to(Vector2(n) + Vector2(0.5, 0.5))
			if d < best_d:
				best_d = d
				best = i
	return best

func _animating(i: int) -> bool:
	for a in anims:
		if a.i == i:
			return true
	return false

func _on_tap(p: Vector2) -> void:
	if not playing or engine.solved() or engine.failed():
		return
	var i := _arrow_at(p)
	if i < 0:
		return
	var r: Dictionary = engine.tap(i)
	if r.get("ignored", false):
		return
	if i == hint_i:
		hint_t = 0.0
	if r.ok:
		anims.append({"i": i, "kind": "out", "t": 0.0, "peak": float(r.to_edge + engine.arrows[i].cells.size() + 2)})
		_sfx("whoosh")
		_buzz(10)
		if level == 1 and mode == "classic" and int(prefs.get("taught", 0)) == 0:
			prefs["taught"] = 1
			SaveUtil.write(PREFS_PATH, prefs)
			_clear_feedback()
	else:
		anims.append({"i": i, "kind": "bump", "t": 0.0, "peak": float(r.free) + 0.35})
		heart_pop = 0.5
		_sfx("invalid")
		_buzz(40)
		_feedback(tr("Blocked! Something is in its way."), _bad_color(), 2.0)
	_save_game()
	_update_hud()
	board.queue_redraw()
	if engine.solved():
		_on_solved()
	elif engine.failed():
		_on_failed()

func _on_hint() -> void:
	home.try_help(_hint_now)

## 💡 help (STANDARDS §17): one arrow that can leave now blinks; nothing moves.
func _hint_now() -> bool:
	if not playing or engine.solved() or engine.failed():
		return false
	var i := engine.hint()
	if i < 0:
		return false
	hint_i = i
	hint_t = 4.0
	hints_used += 1
	_sfx("powerup")
	_save_game()
	# Zoomed in? Bring the arrow into view.
	if zoom > 1.0001:
		var c: Vector2 = Vector2(engine.head(i)) + Vector2(0.5, 0.5)
		_pan(board.size / 2.0 - (vo + c * vs))
	board.queue_redraw()
	return true

## ❤ help: one heart back.
func _heart_now() -> bool:
	if not playing or engine.solved() or not engine.add_heart():
		return false
	heart_pop = 0.5
	fail_dialog.visible = false
	_sfx("powerup")
	_update_hud()
	_save_game()
	return true

func _on_extra_heart() -> void:
	home.try_help(_heart_now)

func _process(delta: float) -> void:
	var redraw := false
	if playing and not engine.solved() and not engine.failed():
		elapsed += delta
		if clock and not home.visible:
			var before := int(ceil(time_left))
			time_left -= delta
			if int(ceil(time_left)) != before:
				_update_hud()
				if before == 11:
					_sfx("notify")
			if time_left <= 0.0:
				_time_up()
	for k in range(anims.size() - 1, -1, -1):
		var a: Dictionary = anims[k]
		a.t += delta
		redraw = true
		if (a.kind == "out" and _anim_s(a) >= float(a.peak)) or (a.kind == "bump" and a.t > 0.4):
			anims.remove_at(k)
	if hint_t > 0.0:
		hint_t = maxf(0.0, hint_t - delta)
		redraw = true
	if heart_pop > 0.0:
		heart_pop = maxf(0.0, heart_pop - delta)
		hearts_box.queue_redraw()
	if redraw:
		board.queue_redraw()

# ---------- drawing ----------

## How far (in cells) a moving arrow has slid: "out" speeds up, "bump" goes there and back.
func _anim_s(a: Dictionary) -> float:
	if a.kind == "out":
		return minf(float(a.peak), a.t * SLIDE_SPEED * (0.6 + a.t * 2.0))
	return a.peak * sin(PI * clampf(a.t / 0.4, 0.0, 1.0))

## Cell centres of arrow i, then on past its head out of the grid (`extra` cells).
func _track(i: int, extra: int) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for c in engine.arrows[i].cells:
		pts.append(Vector2(c) + Vector2(0.5, 0.5))
	var d := Vector2(engine.arrows[i].dir)
	var h: Vector2 = pts[pts.size() - 1]
	for k in range(1, extra + 1):
		pts.append(h + d * k)
	return pts

## The piece of polyline `pts` between parameters a and b (1.0 = one point to the next).
static func _sub(pts: PackedVector2Array, a: float, b: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	var n := pts.size()
	var at := func(t: float) -> Vector2:
		var k := clampi(int(floor(t)), 0, n - 2)
		return pts[k].lerp(pts[k + 1], clampf(t - k, 0.0, 1.0))
	out.append(at.call(a))
	for k in range(int(floor(a)) + 1, int(ceil(b))):
		if k > a and k < b and k < n:
			out.append(pts[k])
	out.append(at.call(b))
	return out

func _draw_board() -> void:
	if engine == null or engine.cols == 0:
		return
	var classic := _is_classic()
	# A paper card under the picture (shadow + sheet), so the board has depth.
	var card := StyleBoxFlat.new()
	card.set_corner_radius_all(int(vs * 0.6))
	card.anti_aliasing = true
	card.bg_color = Color("ffffff") if classic else Color(0.04, 0.05, 0.12)
	card.shadow_color = Color(0.1, 0.15, 0.35, 0.18) if classic else Color(0, 0, 0, 0.6)
	card.shadow_size = int(maxf(6.0, vs * 0.5))
	card.shadow_offset = Vector2(0, maxf(3.0, vs * 0.2))
	if not classic:
		card.border_color = Color(HomeKit.CYAN, 0.2)
		card.set_border_width_all(2)
	var card_r := Rect2(vo, Vector2(engine.cols, engine.rows) * vs).grow(vs * 0.5)
	if zoom <= 1.001:  # fitted: keep the card (and its shadow) inside the board, not clipped
		card_r = card_r.intersection(Rect2(Vector2.ZERO, board.size).grow(-maxf(8.0, vs * 0.5)))
	card.draw(board.get_canvas_item(), card_r)
	# Dotted grid where the picture is.
	var dot_r := maxf(1.2, vs * 0.05)
	var dot_col := DOT if classic else Color(HomeKit.CYAN, 0.22)
	var r0 := maxi(0, int(floor(-vo.y / vs)))
	var r1 := mini(engine.rows, int(ceil((board.size.y - vo.y) / vs)))
	var c0 := maxi(0, int(floor(-vo.x / vs)))
	var c1 := mini(engine.cols, int(ceil((board.size.x - vo.x) / vs)))
	for r in range(r0, r1):
		for c in range(c0, c1):
			if engine.mask[r * engine.cols + c]:
				board.draw_circle(vo + (Vector2(c, r) + Vector2(0.5, 0.5)) * vs, dot_r, dot_col)
	var moving := {}
	for a in anims:
		moving[a.i] = a
	var width := maxf(2.0, vs * 0.15)
	for i in engine.arrows.size():
		var arr: Dictionary = engine.arrows[i]
		if not arr.alive and not moving.has(i):
			continue
		var s := 0.0
		var extra := 1
		if moving.has(i):
			var m: Dictionary = moving[i]
			s = _anim_s(m)
			extra = int(ceil(m.peak)) + 2
		var n: int = arr.cells.size()
		var pts := _track(i, extra)
		var seg := _sub(pts, s, s + n - 1)
		var col := _arrow_color(i)
		if i == hint_i and hint_t > 0.0:
			var a := 0.5 + 0.5 * sin(hint_t * 9.0)
			var glow := Color(HomeKit.GOLD, 0.35 + 0.4 * a) if not classic else Color(1.0, 0.75, 0.1, 0.35 + 0.45 * a)
			_draw_arrow(seg, Vector2(arr.dir), width * 3.0, glow)
		if not classic:
			_draw_arrow(seg, Vector2(arr.dir), width * 2.4, Color(col, 0.18))
		else:
			# soft ink shadow a little down-right: arrows sit on the paper, not in it
			var sh := PackedVector2Array()
			for q in seg:
				sh.append(q + Vector2(0.06, 0.09))
			_draw_arrow(sh, Vector2(arr.dir), width, Color(0.1, 0.14, 0.3, 0.18))
		_draw_arrow(seg, Vector2(arr.dir), width, col)

## A polyline with rounded joints and a triangle head pointing `dir` (cell units → screen).
func _draw_arrow(seg: PackedVector2Array, dir: Vector2, width: float, col: Color) -> void:
	var sp := PackedVector2Array()
	for p in seg:
		sp.append(vo + p * vs)
	var tip: Vector2 = sp[sp.size() - 1] + dir * vs * 0.42
	var base: Vector2 = tip - dir * vs * 0.4
	sp[sp.size() - 1] = base
	board.draw_polyline(sp, col, width)
	for k in range(1, sp.size() - 1):
		board.draw_circle(sp[k], width * 0.5, col)
	board.draw_circle(sp[0], width * 0.5, col)
	var side := Vector2(-dir.y, dir.x) * maxf(width * 1.4, vs * 0.2)
	board.draw_colored_polygon(PackedVector2Array([tip, base + side, base - side]), col)

func _draw_hearts() -> void:
	var r := 15.0
	var gap := 50.0
	var x0 := hearts_box.size.x / 2.0 - gap
	for k in Engine_.HEARTS:
		var full := k < engine.hearts
		var c := Vector2(x0 + k * gap, hearts_box.size.y / 2.0)
		var sc := 1.0
		if heart_pop > 0.0 and k == engine.hearts:  # the heart just lost
			sc = 1.0 + 0.3 * sin(heart_pop / 0.5 * PI)
		var col: Color = (RED if _is_classic() else Color("ff4f6a")) if full else (Color(0.6, 0.62, 0.7, 0.45))
		_heart(hearts_box, c, r * sc, col)

static func _heart(ci: CanvasItem, c: Vector2, r: float, col: Color) -> void:
	ci.draw_circle(c + Vector2(-r * 0.5, -r * 0.25), r * 0.56, col)
	ci.draw_circle(c + Vector2(r * 0.5, -r * 0.25), r * 0.56, col)
	ci.draw_colored_polygon(PackedVector2Array([c + Vector2(-r * 1.03, 0.0), c + Vector2(r * 1.03, 0.0), c + Vector2(0, r * 1.05)]), col)
	ci.draw_rect(Rect2(c + Vector2(-r * 0.9, -r * 0.3), Vector2(r * 1.8, r * 0.35)), col)

## Landing logo: a few original arrows knotted together.
func _draw_home_logo(c: Control) -> void:
	var k := minf(c.size.y * 0.16, 30.0)
	var o := c.size / 2.0 - Vector2(3.0 * k, 2.5 * k)
	var paths := [
		[[0, 1], [3, 1], [3, 0]],
		[[1, 4], [1, 2], [5, 2], [5, 4]],
		[[0, 5], [3, 5], [3, 3], [6, 3]],
		[[6, 0], [4, 0], [4, 1], [6, 1]],
	]
	var cols := [HomeKit.CYAN, HomeKit.PINK, HomeKit.GOLD, HomeKit.LIME]
	for i in paths.size():
		var pts := PackedVector2Array()
		for p in paths[i]:
			pts.append(o + Vector2(p[0], p[1]) * k)
		var n := pts.size()
		var d := (pts[n - 1] - pts[n - 2]).normalized()
		var base := pts[n - 1]
		var tip := base + d * k * 0.55
		var side := Vector2(-d.y, d.x) * k * 0.32
		c.draw_polyline(pts, Color(cols[i], 0.25), 12.0)
		c.draw_polyline(pts, cols[i], 5.0)
		c.draw_colored_polygon(PackedVector2Array([tip, base + side, base - side]), cols[i])

# ---------- win / lose ----------

func _on_solved() -> void:
	playing = false
	_sfx("win")
	SaveUtil.delete(SAVE_PATH)
	var stars := clampi(engine.hearts, 1, 3)
	var note := ""
	match mode:
		"classic":
			var key := str(level)
			progress.stars[key] = maxi(int(progress.stars.get(key, 0)), stars)
			progress.next = maxi(int(progress.next), mini(level + 1, Gen.LEVELS))
			note = "★".repeat(stars) + "☆".repeat(3 - stars)
		"daily":
			if int(progress.get("daily_day", -1)) != day:
				progress.daily_streak = int(progress.get("daily_streak", 0)) + 1 if int(progress.get("daily_day", -1)) == day - 1 else 1
				progress.daily_day = day
			note = tr("Daily streak: %d") % int(progress.daily_streak)
	_save_progress()
	if info:
		info.add("Puzzles solved")
		if engine.mistakes == 0:
			info.add("Perfect boards")
		if mode == "classic":
			info.high("Classic levels", _levels_done())
			info.high("Classic stars", _total_stars())
		if mode == "daily":
			info.high("Daily streak", int(progress.daily_streak))
		info.high("Most arrows cleared", engine.arrows.size())
		info.celebrate(tr("Cleared!"))
	var t := int(elapsed)
	var msg := tr("%d arrows   Time %d:%02d") % [engine.arrows.size(), t / 60, t % 60]
	if note != "":
		msg += "\n" + note
	end_dialog.get_meta("message_label").text = msg
	end_dialog.visible = true

func _on_failed() -> void:
	_sfx("lose")
	fail_dialog.get_meta("message_label").text = tr("%d arrows left. Use a ❤ help to keep going, or start the board again.") % engine.alive_count()
	fail_dialog.visible = true

func _levels_done() -> int:
	return progress.stars.size()

func _total_stars() -> int:
	var t := 0
	for k in progress.stars:
		t += int(progress.stars[k])
	return t

# ---------- puzzles ----------

static func _today() -> int:
	return int(Time.get_unix_time_from_system() / 86400.0)  # UTC day number

func _start_classic() -> void:
	_start_level(clampi(int(progress.get("next", 1)), 1, Gen.LEVELS))

func _start_level(lvl: int) -> void:
	mode = "classic"
	level = lvl
	_begin(Gen.classic(lvl))

func _start_daily() -> void:
	mode = "daily"
	day = _today()
	var p := Gen.generate({"cols": 14, "rows": 20, "shape": Gen.SHAPES[day % Gen.SHAPES.size()], "seed": day * 7919 + 13,
		"max_len": 9, "turn": 0.45, "aim": 0.55})
	p.id = "daily-%d" % day
	_begin(p)

func _start_zen(i: int) -> void:
	mode = "zen"
	zen_tier = i
	var z: Array = ZEN[i]
	var shape: String = "rect" if randf() < 0.3 else Gen.SHAPES[randi() % Gen.SHAPES.size()]
	var p := Gen.generate({"cols": z[1], "rows": z[2], "shape": shape, "seed": randi(), "max_len": z[3], "turn": z[4], "aim": z[5]})
	p.id = "zen"
	_begin(p)

func _begin(p: Dictionary) -> void:
	SaveUtil.delete(SAVE_PATH)
	engine.load_puzzle(p)
	elapsed = 0.0
	hints_used = 0
	clock = mode == "classic" and level >= 4
	time_left = _time_for()
	_begin_play()

func _begin_play() -> void:
	playing = true
	anims.clear()
	hint_t = 0.0
	hint_i = -1
	end_dialog.visible = false
	time_dialog.visible = false
	fail_dialog.visible = engine.failed()
	_clear_feedback()
	zoom = 1.0
	_fit_view()
	_update_hud()
	board.queue_redraw()
	_save_game()
	if mode == "classic" and level == 1 and int(prefs.get("taught", 0)) == 0:
		_feedback(tr("Tap an arrow. It slides out the way it points, if nothing is in its way."), _soft_color(), 0.0)
	elif engine.cols >= 12 and int(prefs.get("pinch_taught", 0)) == 0:
		prefs["pinch_taught"] = 1
		SaveUtil.write(PREFS_PATH, prefs)
		_feedback(tr("Pinch to zoom. Drag with one finger to look around."), _soft_color(), 5.0)

func _next_puzzle() -> void:
	match mode:
		"classic":
			_start_level(mini(level + 1, Gen.LEVELS))
		"zen":
			_start_zen(zen_tier)
		_:
			_start_classic()

func _restart() -> void:
	var p := engine.puzzle_dict()
	_begin(p)

func _on_pause_home() -> void:
	home.pause()

func _go_home() -> void:
	fail_dialog.visible = false
	home.go_home()

# ---------- feedback ----------

func _soft_color() -> Color:
	return Color("2c3d8f") if _is_classic() else Color(0.95, 0.88, 0.6)

func _bad_color() -> Color:
	return RED if _is_classic() else Color("ff7a7a")

## `secs` 0 keeps the text until something replaces it (tutorial line).
func _feedback(text: String, col: Color, secs: float = 3.0) -> void:
	feedback_label.text = text
	feedback_label.add_theme_color_override("font_color", col)
	feedback_timer.stop()
	if secs > 0.0:
		feedback_timer.start(secs)

func _clear_feedback() -> void:
	feedback_label.text = ""

# ---------- save / progress ----------

func _load_progress() -> void:
	var d = SaveUtil.read(PROGRESS_PATH)
	progress = d if d is Dictionary else {}
	if not progress.has("stars") or not progress.stars is Dictionary:
		progress.stars = {}
	if not progress.has("next"):
		progress.next = 1

func _save_progress() -> void:
	SaveUtil.write(PROGRESS_PATH, progress)
	if cloud:
		cloud.saved()
		cloud.report_completion(_levels_done(), Gen.LEVELS)

## Cloud vs device: the copy with more Classic levels cleared (then stars) wins.
func _progress_score(d: Dictionary) -> int:
	var st = d.get("stars", {})
	var total := 0
	if st is Dictionary:
		for k in st:
			total += int(st[k])
		return st.size() * 4 + total
	return 0

# ---------- level select ----------

func _open_level_select() -> void:
	var parts: Array = home.card("📋 Level Select")
	var body: VBoxContainer = parts[1]
	var reached := clampi(int(progress.get("next", 1)), 1, Gen.LEVELS)
	var grid := GridContainer.new()
	grid.columns = 5
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	body.add_child(grid)
	for n in range(1, reached + 1):
		var b := Button.new()
		var st := int(progress.stars.get(str(n), 0))
		b.text = str(n) if st == 0 else "%d
%s" % [n, "★".repeat(st)]
		b.custom_minimum_size = Vector2(0, 70)
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		b.pressed.connect(_pick_level.bind(n, parts[0]))
		grid.add_child(b)
	home.show_card(parts[0])

func _pick_level(n: int, card: Control) -> void:
	home.close_card(card)
	SaveUtil.delete(SAVE_PATH)
	home.play_now(_start_level.bind(n))

func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST or what == NOTIFICATION_APPLICATION_PAUSED:
		_save_game()

func _save_game() -> void:
	if engine == null or not playing or engine.cols == 0 or engine.solved():
		return
	var d := engine.to_dict()
	d["mode"] = mode
	d["level"] = level
	d["zen"] = zen_tier
	d["day"] = day
	d["elapsed"] = elapsed
	d["hints"] = hints_used
	d["time_left"] = time_left
	SaveUtil.write(SAVE_PATH, d)

func _resume_text() -> String:
	var d = SaveUtil.read(SAVE_PATH)
	if not d is Dictionary:
		return ""
	if str(d.get("mode", "")) == "classic":
		return tr("Level %d") % int(d.get("level", 1))
	var t := int(float(d.get("elapsed", 0.0)))
	return tr("Time %d:%02d") % [t / 60, t % 60]

func _load_saved_game() -> void:
	var d = SaveUtil.read(SAVE_PATH)
	if not d is Dictionary or not engine.from_dict(d):
		_start_classic()
		return
	mode = str(d.get("mode", "classic"))
	level = int(d.get("level", 1))
	zen_tier = clampi(int(d.get("zen", 0)), 0, ZEN.size() - 1)
	day = int(d.get("day", 0))
	elapsed = float(d.get("elapsed", 0.0))
	hints_used = int(d.get("hints", 0))
	clock = mode == "classic" and level >= 4
	time_left = float(d.get("time_left", _time_for()))
	_begin_play()

func _sfx(sound: String) -> void:
	var s = get_node_or_null("/root/Sfx")
	if s:
		s.play(sound)

## A short buzz, when the player has vibration on (Settings, app v0.21+).
func _buzz(ms: int) -> void:
	var st = get_node_or_null("/root/Settings")
	if st and st.has_method("buzz"):
		st.buzz(ms)
