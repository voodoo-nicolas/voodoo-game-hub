func _ready() -> void:
	if ResourceLoader.exists(I18N_PATH):
		load(I18N_PATH).install(self)
	Orientation.lock_portrait()
	engine = Engine_.new()
	_load_progress()
	if ResourceLoader.exists(CLOUD_SAVE):
		cloud = load(CLOUD_SAVE).new()
		cloud.setup("arrows", PROGRESS_PATH, _progress_score, _load_progress)
		add_child(cloud)
	var p = SaveUtil.read(PREFS_PATH)
	prefs = p if p is Dictionary else {}
	# colors = int(prefs.get("colors", 0))
	colors = int(prefs.get("colors", 1))  # [CHANGED 2026-11-20] colourful arrows by default
	_build_ui()
	var m = get_node_or_null("/root/Music")
	if m:
		m.play("calm", self, 1, 2.0)

