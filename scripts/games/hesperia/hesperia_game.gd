extends Control

## Hesperia in the hub: the Landing (Landing kit) + the standalone game running in a 384x216 pixel-art
## SubViewport, scaled by whole numbers, with the shared Pad (overlay controller) on top.
## Source of truth: D:\Dev\Hesperia\hesperia (standalone). Everything under game/, core/, data.gd,
## world_state.gd, ws_bus.gd and games/hesperia/ is GENERATED by its tools/port_to_hub.py: edit the
## standalone, re-run the port. Only this file, _help, _engine, _i18n and the synced kit are hub-side.
## Landing menu style: S3 Rail List (docs/MENU_STYLES.md); last two games: stickers (mini_golf_3d), ghost (wolf_pack).

const Orientation = preload("res://scripts/common/orientation.gd")
const SettingsDrawer = preload("res://scripts/common/settings_drawer.gd")
const HomeKit = preload("res://scripts/games/hesperia/home_kit.gd")
const MenuStyles = preload("res://scripts/games/hesperia/menu_styles.gd")
const HELP = preload("res://scripts/games/hesperia/hesperia_help.gd")
const MAIN = preload("res://scripts/games/hesperia/game/main.gd")
const Prefs = preload("res://scripts/games/hesperia/game/prefs.gd")
const Data = preload("res://scripts/games/hesperia/data.gd")
const WorldState = preload("res://scripts/games/hesperia/world_state.gd")
const Art = preload("res://scripts/games/hesperia/game/art.gd")
const GAME_INFO_PATH := "res://scripts/common/game_info.gd"
const PAD_PATH := "res://scripts/common/pad/pad_controller.gd"  # APK-side: older apps keep Hesperia's own touch pad
const SAVE_PATH := "user://hesperia_save.json"
const VIEW := Vector2i(384, 216)
const ACCENT := Color("e8b44a")

var info = null
var home
var pad: Control = null
var box: SubViewportContainer
var view: SubViewport
var game = null          # Hesperia main.gd (Node2D) inside the SubViewport

func _ready() -> void:
	Orientation.lock_landscape()
	process_mode = Node.PROCESS_MODE_ALWAYS
	set_anchors_preset(Control.PRESET_FULL_RECT)
	theme = HomeKit.neon_theme(ACCENT)
	var bg := ColorRect.new()
	bg.color = Color(0.04, 0.04, 0.07)
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(bg)
	box = SubViewportContainer.new()
	box.stretch = true
	# ALWAYS: a paused SubViewportContainer drops every tap, and Hesperia pauses the tree for dialogue,
	# shop and menus (their buttons are inside). The game itself stays PAUSABLE (set in _spawn).
	box.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(box)
	view = SubViewport.new()
	view.size = VIEW
	view.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
	view.handle_input_locally = true
	box.add_child(view)
	resized.connect(_fit)
	_add_pad()
	if ResourceLoader.exists(GAME_INFO_PATH):
		info = load(GAME_INFO_PATH).new(HELP)
	home = HomeKit.new({
		# Menu style (docs/MENU_STYLES.md): S3 Rail List; colours: night sea and temple gold.
		"landing": "rail",
		"landing_style": MenuStyles,
		"landing_colors": [Color("070b18"), Color("1d2a44")],
		"art": "res://games/hesperia/landing_bg.jpg",   # night cove under the temple (owner art, prompt A7c)
		"landing_art": true,
		"landing_art_alpha": 0.8,
		"menu_color": Color("ffd98a"),
		"help": HELP,
		"info": info,
		"accent": ACCENT,
		"subtitle": "Raiders burned your cove. Take up the gaff.",
		"logo": _draw_home_logo,
		"solo_heading": "Journey",
		"modes": [{"text": "🏛 New journey", "sub": "The raid on Halcyon Cove", "action": new_journey}],
		"save_path": SAVE_PATH,
		"resume": continue_journey,
		"restart": new_journey,
		"board": "none",
		"quick_with_save": false,
	})
	add_child(home)
	if info:
		add_child(info)
	add_child(SettingsDrawer.new())
	_fit()

## Whole-number pixel scale, centred (black bars on odd aspect ratios).
func _fit() -> void:
	if box == null:
		return
	var k := maxi(1, mini(int(size.x / VIEW.x), int(size.y / VIEW.y)))
	var s := Vector2(VIEW * k)
	box.stretch_shrink = k
	box.size = s
	box.position = ((size - s) * 0.5).floor()

func _draw_home_logo(c: Control) -> void:
	if ResourceLoader.exists("res://games/hesperia/landing_bg.jpg"):
		return   # the painted temple in the Landing art is the logo
	var mid := c.size / 2.0
	HomeKit.glow_text(c, mid, "🏛", int(c.size.y * 0.45), ACCENT)   # the rail style already prints the title

# ================================================================ game

func _spawn() -> void:
	if game != null and is_instance_valid(game):
		game.queue_free()
	game = MAIN.new()
	game.process_mode = Node.PROCESS_MODE_PAUSABLE   # its UI layer / HUD are ALWAYS on their own
	view.add_child(game)
	Data.lang = "es" if TranslationServer.get_locale().begins_with("es") else "en"
	Prefs.lang = Data.lang
	if pad != null:
		Prefs.touch_mode = "off"      # the Pad replaces Hesperia's own on-screen buttons
	game.ui.quit_to_title_requested.connect(_on_quit_to_title)
	home.hide_home()

## New journey, Beached-style: full-screen hub cards (not the 384x216 game UI, too small to tap / type in):
## 1) tap a hero (2 bodies x 5 hair colours), 2) type a name (box at the top: the keyboard covers the bottom).
func new_journey() -> void:
	home.hide_home()
	_pick_look()

const HAIRS := ["brown", "black", "blonde", "orange", "white"]

func _card(title: String) -> VBoxContainer:
	var card := PanelContainer.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.03, 0.04, 0.08, 0.97)
	sb.content_margin_top = 28
	sb.content_margin_bottom = 20
	card.add_theme_stylebox_override("panel", sb)
	card.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	card.name = "HesperiaCard"
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	card.add_child(col)
	var l := Label.new()
	l.text = tr(title)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.add_theme_font_size_override("font_size", 30)
	l.add_theme_color_override("font_color", ACCENT)
	col.add_child(l)
	add_child(card)
	return col

func _pick_look() -> void:
	Data.lang = "es" if TranslationServer.get_locale().begins_with("es") else "en"
	Data.load_all()   # the name defaults (tr_ui) before the game exists
	var col := _card("Choose your hero")
	col.alignment = BoxContainer.ALIGNMENT_CENTER
	var grid := GridContainer.new()
	grid.columns = HAIRS.size()
	grid.add_theme_constant_override("h_separation", 18)
	grid.add_theme_constant_override("v_separation", 18)
	var center := CenterContainer.new()
	center.add_child(grid)
	col.add_child(center)
	var h := clampf((size.y - 160.0) / 2.0, 90.0, 240.0)
	for male in [true, false]:
		for hair in HAIRS:
			var base := "hero_m" if male else "hero_f"
			var key: String = base + ("" if hair == "brown" else "_" + hair) + "_walk_down"
			var b := TextureButton.new()
			b.texture_normal = Art.anim_frame_tex(key)
			b.ignore_texture_size = true
			b.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
			b.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			b.custom_minimum_size = Vector2(h * 0.6, h)
			b.pressed.connect(_on_look_picked.bind(col.get_parent(), male, hair))
			grid.add_child(b)
	var back := Button.new()
	back.text = tr("← Back")
	back.custom_minimum_size = Vector2(160, 52)
	back.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	back.pressed.connect(_on_card_back.bind(col.get_parent()))
	col.add_child(back)

func _on_card_back(card: Control) -> void:
	card.queue_free()
	home.show_home()

func _on_look_picked(card: Control, male: bool, hair: String) -> void:
	card.queue_free()
	var col := _card("What's your name?")
	col.alignment = BoxContainer.ALIGNMENT_BEGIN
	var row := HBoxContainer.new()
	row.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_theme_constant_override("separation", 10)
	col.add_child(row)
	var edit := LineEdit.new()
	edit.max_length = 12
	edit.placeholder_text = Data.tr_ui("default_name_m") if male else Data.tr_ui("default_name_f")
	edit.alignment = HORIZONTAL_ALIGNMENT_CENTER
	edit.add_theme_font_size_override("font_size", 26)
	edit.custom_minimum_size = Vector2(300, 52)
	row.add_child(edit)
	var c2: Control = col.get_parent()
	for pair in [["OK", true], ["Skip", false]]:
		var b := Button.new()
		b.text = tr(pair[0])
		b.custom_minimum_size = Vector2(110, 52)
		b.pressed.connect(_on_name_done.bind(c2, edit, male, hair, pair[1]))
		row.add_child(b)
	edit.text_submitted.connect(_on_name_submitted.bind(c2, edit, male, hair))
	edit.grab_focus()

func _on_name_submitted(_t: String, card: Control, edit: LineEdit, male: bool, hair: String) -> void:
	_on_name_done(card, edit, male, hair, true)

func _on_name_done(card: Control, edit: LineEdit, male: bool, hair: String, use: bool) -> void:
	var nm := edit.text.strip_edges() if use else ""
	card.queue_free()
	_spawn()
	if nm == "":
		nm = Data.tr_ui("default_name_m") if male else Data.tr_ui("default_name_f")
	game.ui.hair_pick = hair
	game.ui._leave_title()
	game._on_new_game(nm, male)

func continue_journey() -> void:
	_spawn()
	game.ui.close()
	game._on_continue()

func _on_quit_to_title() -> void:
	home.show_home()

## Called by the kit before pause / leaving.
func _save_game() -> void:
	if game != null and is_instance_valid(game) and game.in_game and not game.prologue_running:
		WorldState.save_game()

# ================================================================ the Pad (overlay controller)

func _add_pad() -> void:
	if not ResourceLoader.exists(PAD_PATH):
		return
	pad = load(PAD_PATH).new()
	pad.layout_override = "stick_4"
	pad.works_while_paused = true    # dialogue / shop / menus pause the tree and are driven by A and the stick
	pad.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(pad)
	pad.set_map({
		"move": ["mv_left", "mv_right", "mv_up", "mv_down"],
		"a": ["btn_a"], "b": ["btn_b"], "x": ["btn_x"], "y": ["btn_y"],
		"info": ["menu"],
	})
	pad.button_pressed.connect(_on_pad_button)
	pad.set_state("a", {"sub": tr("SWORD")})
	pad.set_state("b", {"sub": tr("SHIELD")})
	pad.set_state("info", {"icon": "menu"})
	pad.visible = false

func _on_pad_button(id: String) -> void:
	if id == "pause" and home != null:
		home.pause()

func _process(_dt: float) -> void:
	if pad == null:
		return
	var kit_open: bool = home.is_home_visible() or home.pause_overlay.visible
	pad.visible = game != null and is_instance_valid(game) and game.in_game and not kit_open
	if pad.visible:
		pad.set_hidden("x", WorldState.equipped_x == "")
		pad.set_hidden("y", WorldState.equipped_y == "")

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_PAUSED:
		_save_game()
